  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f61ca6d5e8aaaa541b5c5e0029d0d94b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - "\uFF08!?\u4F55\u3060\u3053\u308C\u306F\u2026\u2026\u3002\u968E\u4E0B\u3078\u306E\u96A0\u3057\u901A\u8DEF?\u306A\u3093\u3067\u4ECA\u306B\u306A\u3063\u3066\u6025\u306B\u73FE\u308C\u305F\u3093\u3060?\uFF09"
  - "\u300C\u5E78\u4EBA\u541B\u3069\u3046\u3057\u305F\u306E!?\u65E9\u304F\u9032\u307E\u306A\u3044\u3068\u3042\u3044\u3064\u304C\u3084\u3063\u3066\u304D\u3061\u3083\u3046\u3088!!\u300D"
  - "\u300C\u3042\u3001\u3042\u3041\u3002\u3054\u3081\u3093\u3002\u5148\u306B\u9032\u3082\u3046\u304B\u3002\u300D"
  - "\uFF08\u3069\u3053\u306B\u3064\u306A\u304C\u3063\u3066\u3044\u308B\u304B\u5206\u304B\u3089\u306A\u3044\u4EE5\u4E0A\u304B\u306A\u308A\u30EA\u30B9\u30AF\u306F\u9AD8\u3044\u304C\u4ED5\u65B9\u304C\u306A\u3044\u2026\u2026\u3002\uFF09"
  names:
  - "\u5E78\u4EBA"
  - "\u6674"
  - "\u5E78\u4EBA"
  - "\u5E78\u4EBA"
  image:
  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  - {fileID: 21300000, guid: 233c2cfbf821e1e4793b14221a8eec6c, type: 3}
  - {fileID: 21300000, guid: 384b34c672399504b8966716d5e2bf44, type: 3}
  - {fileID: 21300000, guid: 81e290a9b2b1fb7408c3ef36177bfe76, type: 3}
  messages2:
  - "\uFF08\u6697\u3044\u2026\u2026\u3002\u4E00\u4F53\u3069\u3053\u307E\u3067\u7D9A\u3044\u3066\u3044\u308B\u3093\u3060\u3002\uFF09"
  - "\u300C\u306D\u3001\u306D\u3047\u3002\u5E78\u4EBA\u541B\u3002\u3053\u308C\u672C\u5F53\u306B\u5927\u4E08\u592B\u306A\u306E\u304B\u306A\uFF1F\u3053\u3093\u306A\u6697\u3044\u3068\u3053\u308D\u3067\u3042\u3044\u3064\u306B\u8972\u308F\u308C\u305F\u3089\u2026\u2026\u3002\u300D"
  - "\u300C\u5927\u4E08\u592B\u3060\u3002\u305F\u3057\u304B\u306B\u304F\u3089\u3044\u304C\u3053\u306E\u72ED\u3055\u306A\u3089\u3042\u306E\u5316\u3051\u7269\u306E\u4F53\u304C\u5165\u308B\u3053\u3068\u306F\u51FA\u6765\u306A\u3044\u3088\u3002\u300D"
  - "\u300C\u305D\u308C\u306B\u3042\u306E\u307E\u307E\u5C4B\u6577\u3092\u9003\u3052\u56DE\u3063\u3066\u3082\u3001\u3042\u3044\u3064\u306F\u8DB3\u304C\u901F\u3059\u304E\u3066\u3044\u3064\u304B\u6355\u307E\u3063\u3066\u3057\u307E\u3046\u3002\u9006\u306B\u3053\u306E\u9053\u304C\u898B\u3064\u304B\u3063\u305F\u306E\u306F\u5E78\u904B\u3060\u3088\u3002\u300D"
  - "\u305D\u306E\u3088\u3046\u306B\u4F1A\u8A71\u3092\u5E83\u3052\u3066\u3044\u304F\u3068\u5E78\u4EBA\u306E\u982D\u304C\u4F55\u304B\u306B\u3076\u3064\u304B\u308A\u5F53\u305F\u308A\u306B\u920D\u3044\u97F3\u304C\u5E83\u304C\u308B\u3002"
  - "\u300C\u75DB\u3066\u3063!!\u4F55\u3060\u2026\u2026\u3063\u3066\u884C\u304D\u6B62\u307E\u308A!?\u300D"
  - "\u300C\u3048\u3001\u3053\u3053\u3067\u7D42\u308F\u308A\u306A\u306E!?\u305D\u308C\u3063\u3066\u304B\u306A\u308A\u307E\u305A\u304F\u306A\u3044\u2049\u3069\u3046\u3057\u3088\u3046\u2026\u2026\u3002\u3069\u3046\u3057\u3088\u3046\u3002\u300D"
  - "\u300C\u4E00\u65E6\u843D\u3061\u7740\u3051\u3002\u5927\u4E08\u592B\u3060\u3001\u4E0B\u306B\u6249\u304C\u3042\u3063\u305F\u3002\u3069\u3061\u3089\u304B\u3068\u3044\u3046\u3068\u30CF\u30C3\u30C1\u307F\u305F\u3044\u306A\u3082\u306E\u304B\u3002\u300D"
  - "\u300C\u3048!?\u307E\u3055\u304B\u964D\u308A\u308B\u306E\u2049\u5371\u306A\u3044\u3088\u203C\u300D"
  - "\u300C\u3053\u306E\u307E\u307E\u3053\u3053\u306B\u5C45\u5EA7\u3063\u3066\u3082\u3057\u3087\u3046\u304C\u306A\u3044\u3060\u308D\u3002\u4FFA\u304C\u5148\u306B\u964D\u308A\u3066\u78BA\u8A8D\u3059\u308B\u304B\u3089\u5B89\u5168\u305D\u3046\u306A\u3089\u6674\u3082\u7D9A\u3044\u3066\u304F\u308C\u3002\u300D"
  - "\u300C\u3061\u3087\u3063\u3068!\u305D\u3093\u306A\u3044\u304D\u306A\u308A\u6C7A\u3081\u306A\u3044\u3067\u3088\u2026\u2026\u3002\u300D"
