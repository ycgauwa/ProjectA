  seimessages: []
  seinames: []
  seiimages: []
  sentences:
  - "\u300C\u3053\u306E\u6751\u306B\u4F4F\u307F\u59CB\u3081\u3066\u7D04\u534A\u5E74\u304C\u7D4C\u3063\u305F\u3002\u521D\u3081\u3066\u306E\u51AC\u306F\u5B50\u4F9B\u306B\u3068\u3063\u3066\u3064\u3089\u304B\u3063\u305F\u3088\u3046\u3067\u5BD2\u3055\u3092\u3057\u306E\u3052\u308B\u5834\u6240\u3092\u63A2\u3057\u3066\u3044\u305F\u3089\u3053\u3093\u306A\u5834\u6240\u3092\u898B\u3064\u3051\u305F\u3089\u3057\u3044\u300D"
  - "\u300C\u3053\u306E\u6751\u306B\u3053\u3093\u306A\u5DE8\u5927\u306A\u5730\u4E0B\u7A7A\u9593\u304C\u5B58\u5728\u3059\u308B\u306A\u3093\u3066\u77E5\u3089\u306A\u304B\u3063\u305F\u3002\u6751\u9577\u3084\u53CB\u4EBA\u306F\u3053\u306E\u3053\u3068\u3092\u77E5\u3063\u3066\u3044\u308B\u306E\u3060\u308D\u3046\u304B\u3002\u300D"
