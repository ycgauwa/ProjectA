  messages:
  - "\uFF08\u6559\u79D1\u66F8\u306A\u3069\u306E\u8CC7\u6599\u304C\u5165\u3063\u305F\u68DA\u304C\u4E26\u3093\u3067\u3044\u308B\uFF09"
  - "\u300C\u3042\u308C\u3001\u3053\u308C\u6559\u79D1\u66F8\u3058\u3083\u306A\u304F\u3066\u65E5\u8A18\u307F\u305F\u3044\u3060\u306A\u2026\u2026\uFF1F\u300D"
  - "\u300C\u3061\u3087\u3063\u3068\u3060\u3051\u8997\u3044\u3066\u307F\u308B\u304B\u3002\u300D"
  names:
  - 
  - "\u5E78\u4EBA"
  - "\u5E78\u4EBA"
  image:
  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  seimessages: []
  seinames: []
  seiimages: []
  sentences:
  - "\u300C\u3042\u306E\u4E0D\u601D\u8B70\u306A\u4F53\u9A13\u304B\u3089\u305D\u3053\u305D\u3053\u306E\u6642\u9593\u304C\u7D4C\u904E\u3057\u305F\u304C\u3001\u72B6\u6CC1\u306F\u60AA\u5316\u3057\u3066\u3044\u308B\u3088\u3046\u306B\u601D\u3048\u308B\u3002\u79C1\u304C\u9055\u548C\u611F\u3092\u611F\u3058\u3066\u3044\u3066\u3082\u307B\u304B\u306E\u6559\u54E1\u3084\u751F\u5F92\u306F\u4F55\u98DF\u308F\u306C\u9854\u3067\u904E\u3054\u3057\u3066\u3044\u308B\u3002\u300D"
  - "\u300C\u65E5\u306B\u65E5\u306B\u81EA\u5206\u3060\u3051\u304C\u3053\u306E\u304A\u304B\u3057\u306A\u7A7A\u9593\u306B\u53D6\u308A\u6B8B\u3055\u308C\u3066\u3044\u308B\u611F\u899A\u304C\u3057\u3066\u982D\u304C\u304A\u304B\u3057\u304F\u306A\u308A\u305D\u3046\u3060\u3002\u300D"
  - "\u300C\u4ECA\u65E5\u3001\u6559\u982D\u306B\u9000\u8077\u5C4A\u3092\u63D0\u51FA\u3057\u305F\u3002\u3082\u3046\u3042\u306E\u7A7A\u9593\u304C\u8010\u3048\u3089\u308C\u306A\u3044\u3002\u6570\u30AB\u6708\u306B1\u5EA6\u4F55\u4EBA\u304B\u306E\u751F\u5F92\u304C\u5B9A\u671F\u7684\u306B\u6D88\u3048\u3066\u3044\u304F\u3002\u305D\u308C\u3092\u3053\u306E\u5B66\u6821\u306B\u6240\u5C5E\u3059\u308B\u4EBA\u306F\u8AB0\u3082\u6C17\u3065\u3051\u306A\u3044\u3002\u300D"
  - "\u300C\u660E\u3089\u304B\u306B\u304A\u304B\u3057\u3044\u70B9\u304C\u3044\u304F\u3064\u3082\u3042\u308B\u306E\u306B\u3001\u305D\u308C\u3092\u6307\u6458\u3057\u3066\u3082\u5468\u308A\u306E\u4EBA\u9593\u306F\u7B11\u9854\u3067\u4F55\u3082\u304A\u304B\u3057\u306A\u3068\u3053\u308D\u306F\u306A\u3044\u3068\u8FD4\u3057\u3066\u304F\u308B\u3002\u300D"
  - "\u300C\u81EA\u5206\u3060\u3051\u304C\u6C17\u3065\u3044\u3066\u306F\u3044\u3051\u306A\u3044\u3088\u3046\u306A\u3053\u3068\u306B\u6C17\u3065\u3044\u3066\u3057\u307E\u3063\u305F\u6C17\u304C\u3057\u3066\u6C17\u6301\u3061\u304C\u60AA\u304B\u3063\u305F\u3002\u300D"
