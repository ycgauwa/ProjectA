  messages5:
  - "\u300C\u3063!!!\u3042\u3042\u3042\u3042\u3041\u3041!!\u300D"
  - "\uFF08\u306A\u3093\u3060\u3053\u308C\u306F\uFF01\uFF1F\u30CE\u30D6\u3092\u63E1\u3063\u305F\u3068\u601D\u3063\u305F\u3089\u624B\u304C\u6025\u306B\u52D5\u304B\u306A\u304F\u306A\u3063\u3066\u6C17\u304C\u3064\u3044\u305F\u3089\u624B\u304C\u51CD\u3063\u3066\u3044\u308B\u306E\u304B\uFF1F\uFF09"
  - "\uFF08\u3042\u3063\u3068\u3044\u3046\u9593\u306B\u611F\u899A\u3082\u306A\u304F\u306A\u3063\u305F\u3002\u3082\u3046\u52D5\u304B\u3059\u3053\u3068\u304C\u51FA\u6765\u306A\u3044\u3002\uFF09"
  - "\u300C\u3050\u3046\u3045\u3045\u3045\u2026\u2026\u3002\u3084\u3089\u304B\u3057\u305F\uFF01\u3053\u3093\u306A\u5371\u967A\u306A\u6C11\u5BB6\u306B\u4E00\u4EBA\u3067\u8EAB\u52D5\u304D\u304C\u3068\u308C\u306A\u3044\u72B6\u6CC1\u306F\u975E\u5E38\u306B\u307E\u305A\u3044\u3002\u300D"
