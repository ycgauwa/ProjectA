  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - "\u30D9\u30C3\u30C8\u306E\u4E0A\u306B\u306F\u982D\u304C\u3044\u3073\u3064\u306B\u80A5\u5927\u5316\u3057\u767D\u304F\u5909\u8272\u3057\u305F\u4EBA\u304C\u6A2A\u305F\u308F\u3063\u3066\u3044\u308B\u3002"
  - "\u5DE6\u8155\u3082\u982D\u3068\u540C\u69D8\u306B\u5909\u5316\u3057\u3066\u304A\u308A\u3001\u307E\u308B\u3067\u4EBA\u9593\u4EE5\u5916\u306E\u306A\u306B\u304B\u306B\u751F\u307E\u308C\u5909\u308F\u3063\u3066\u3044\u308B\u6700\u4E2D\u306E\u3088\u3046\u306A\u3044\u5370\u8C61\u3092\u53D7\u3051\u308B\u3002"
  - "\u5E78\u4EBA\u306F\u3059\u3063\u3068\u9996\u5143\u306B\u6307\u3092\u6DFB\u3048\u305F\u3002"
  - "\u300C\u8108\u304C\u306A\u3044\u2026\u2026\u6B7B\u3093\u3067\u3044\u308B\u306E\u304B\uFF1F\u300D"
  - "\u521D\u3081\u3066\u898B\u308B\u4EBA\u306E\u6B7B\u4F53\u3001\u305D\u308C\u3082\u7570\u5F62\u306E\u5F62\u3092\u3057\u305F\u7269\u3092\u898B\u3066\u308F\u305A\u304B\u306B\u52D5\u63FA\u3059\u308B\u3002"
  - "\u300C\u3053\u3053\u304C\u5316\u3051\u7269\u306E\u3044\u308B\u5BB6\u3060\u3063\u305F\u308A\u3001\u8FFD\u3044\u304B\u3051\u307E\u308F\u3055\u308C\u306A\u304B\u3063\u305F\u3089\u6CE3\u304D\u53EB\u3093\u3067\u305F\u3060\u308D\u3046\u306A\u2026\u2026\u3002\u300D"
  - "\uFF08\u305D\u308C\u306B\u3057\u3066\u3082\u3053\u306E\u907A\u4F53\u306F\u4F55\u306A\u3093\u3060\uFF1F\u3053\u306E\u5927\u304D\u304F\u306A\u3063\u305F\u8155\u306E\u90E8\u5206\u306A\u3093\u3066\u3055\u3063\u304D\u306E\u5BB6\u3067\u51FA\u4F1A\u3063\u305F\u5316\u3051\u7269\u307F\u305F\u3044\u3060\u3002\uFF09"
  - "\uFF08\u306A\u3093\u306B\u305B\u3088\u3001\u6C17\u5473\u304C\u60AA\u3044\u3057\u65E9\u304F\u3053\u306E\u5BB6\u304B\u3089\u51FA\u3066\u3044\u304D\u305F\u3044\u306A\u3002\uFF09"
  - "\u6B7B\u4F53\u3092\u6539\u3081\u3066\u3058\u3063\u304F\u308A\u3068\u898B\u56DE\u3057\u3066\u307F\u308B\u3068\u80A5\u5927\u5316\u3057\u305F\u624B\u306B\u4F55\u304B\u304C\u63E1\u3089\u308C\u3066\u3044\u305F\u3002"
  - "\u300C\u3042\u308C\uFF1F\u3053\u308C\u3063\u3066\u2026\u2026\u3002\u300D"
  - "\u96D1\u52D9\u5BA4\u306E\u9375\u3092\u624B\u306B\u5165\u308C\u305F\u3002"
  - "\u300C\u3053\u308C\u3067\u3053\u306E\u5BB6\u6700\u5F8C\u306E\u90E8\u5C4B\u306B\u5165\u308C\u305D\u3046\u3060\u306A\u3002\u5FF5\u306E\u305F\u3081\u8ABF\u3079\u3089\u308C\u308B\u7269\u306F\u5168\u90E8\u8ABF\u3079\u3066\u7F6E\u3044\u305F\u65B9\u304C\u3088\u3055\u305D\u3046\u3060\u3002\u300D"
