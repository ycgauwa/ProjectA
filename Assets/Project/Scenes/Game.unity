  messages4:
  - "\u300C\u305D\u3046\u3060\u3088\u306A\u2026\u2026\u3002\u4FFA\u306F\u51FA\u305F\u3044\u3093\u3060\u3063!\u3053\u3093\u306A\u5316\u3051\u7269\u304C\u3044\u308B\u5834\u6240\u304B\u3089\u4E00\u523B\u3082\u65E9\u304F\u2026\u2026\u3002\u300D"
  - "\u300C\u305D\u3046\u3060\u3063!\u7121\u4E8B\u306B\u3053\u3053\u304B\u3089\u51FA\u308C\u305F\u3089\u6674\u3084\u4ED6\u306E\u307F\u3093\u306A\u3082\u52A9\u3051\u3066\u3082\u3089\u3048\u308B\u3088\u3046\u306B\u8B66\u5BDF\u3092\u547C\u3070\u306A\u3044\u3068!\u5B66\u6821\u306B\u3082\u9023\u7D61\u3092\u5165\u308C\u305F\u308A\u3057\u3066\u2026\u2026\u300D"
  - "\u300C\u3042\u3041\u5927\u5909\u3060\u3001\u3053\u3053\u304B\u3089\u51FA\u305F\u3089\u5FD9\u3057\u304F\u306A\u308B\u305E\u2026\u2026!\u300D"
