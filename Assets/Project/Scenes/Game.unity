  messages:
  - "\uFF08\u65E5\u8A18\u306E\u3088\u3046\u306A\u3082\u306E\u304C\u843D\u3061\u3066\u3044\u308B\u3002\uFF09"
  - "\u300C\u4F55\u304B\u624B\u639B\u304B\u308A\u304C\u3042\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u3057\u8AAD\u3093\u3067\u307F\u308B\u304B\u3002\u300D"
  names:
  - "\u5E78\u4EBA"
  - "\u5E78\u4EBA"
  image:
  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  seimessages: []
  seinames: []
  seiimages: []
  sentences:
  - "\u3053\u306E\u8A18\u9332\u306F\u4FFA\u304C\u6B63\u6C17\u3067\u3044\u308B\u305F\u3081\u306B\u3001\u3053\u306E\u72C2\u3063\u305F\u4E16\u754C\u3067\u81EA\u5206\u3082\u540C\u3058\u3088\u3046\u306B\u72C2\u308F\u306A\u3044\u3088\u3046\u306B\u3053\u3053\u3067\u306E\u8A18\u9332\u3092\u793A\u3057\u305F\u65E5\u8A18\u3060\u3002"
  - "\u3053\u3053\u306E\u6751\u304B\u3089\u4F55\u3068\u304B\u8131\u51FA\u3057\u3088\u3046\u3068\u3057\u3066\u65E2\u306B2\u9031\u9593\u304C\u7D4C\u904E\u3057\u305F\u3002\u4E00\u7DD2\u306B\u98DB\u3070\u3055\u308C\u305F\u30E1\u30F3\u30D0\u30FC\u306E\u5927\u534A\u304C\u6B7B\u3093\u3067\u3044\u304F\u306E\u3092\u898B\u3066\u304D\u305F\u3057\u6B8B\u308A\u306E\u30E1\u30F3\u30D0\u30FC\u3060\u3063\u3066\u3069\u3046\u306A\u3063\u305F\u304B\u306A\u3093\u3066\u5206\u304B\u308B\u306F\u305A\u3082\u306A\u3044\u3002"
  - "\u9650\u754C\u3092\u8D85\u3048\u3066\u306A\u3093\u3068\u304B\u5751\u9053\u304B\u3089\u51FA\u305F\u3068\u601D\u3063\u305F\u3089\u307E\u305F\u3082\u3084\u9589\u9396\u7684\u306A\u6C11\u5BB6\u306E\u4E2D\u306B\u51FA\u3066\u3057\u307E\u3063\u305F\u3002\u3069\u3046\u305B\u3053\u306E\u5834\u6240\u306B\u3082\u6050\u308D\u3057\u3044\u5316\u3051\u7269\u304C\u3044\u308B\u306B\u9055\u3044\u306A\u3044\u3002"
  - "\u3053\u306E\u6C11\u5BB6\u3067\u3082\u4F55\u3082\u8131\u51FA\u306E\u624B\u304C\u304B\u308A\u3092\u898B\u3064\u3051\u3089\u308C\u306A\u304B\u3063\u305F\u3089\u81EA\u3089\u306E\u547D\u3092\u7D76\u3064\u3053\u3068\u306B\u3057\u305F\u3002\u4ECA\u307E\u3067\u6C17\u304C\u72C2\u308F\u306A\u3044\u3088\u3046\u306B\u65E5\u8A18\u3092\u66F8\u304D\u7D9A\u3051\u3066\u3044\u305F\u304C\u3082\u3046\u9650\u754C\u304C\u304D\u3066\u3057\u307E\u3063\u305F\u3002"
  - "\u3082\u3057\u8AAD\u3093\u3067\u3044\u308B\u4EBA\u304C\u3044\u305F\u306A\u3089\u3053\u306E\u8A18\u9332\u306F\u907A\u66F8\u3068\u3057\u3066\u4FFA\u306E\u8EAB\u306E\u56DE\u308A\u306E\u4EBA\u306B\u4F1D\u3048\u3066\u6B32\u3057\u3044\u3002\u7279\u306B\u4E21\u89AA\u3068\u5927\u5207\u306A\u59B9\u306B"
