  messages:
  - "\u672C\u68DA\u306E\u3088\u3046\u3060\u7279\u306B\u3081\u307C\u3057\u3044\u672C\u306F\u306A\u3044"
  - "\u300C\u3093\uFF1F\u306A\u3093\u3060\u3053\u308C\u306F\uFF1F\u300D"
  - "\u300C\u672C\u68DA\u306E\u4E2D\u306B\u4F55\u304B\u4E00\u518A\u6BDB\u8272\u306E\u9055\u3046\u3082\u306E\u304C\u53CE\u307E\u3063\u3066\u3044\u308B\u306A\u3002\u300D"
  names:
  - 
  - "\u5E78\u4EBA"
  - "\u5E78\u4EBA"
  image:
  - {fileID: -37872183, guid: 3dac2d2904d78614695ce405add47c02, type: 3}
  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  seimessages: []
  seinames: []
  seiimages: []
  sentences:
  - "\u3053\u306E\u8A18\u9332\u306F\u81EA\u5206\u306E\u751F\u304D\u305F\u8A3C\u3092\u6B8B\u3059\u305F\u3081\u305D\u3057\u3066\u4E00\u7DD2\u306B\u5DFB\u304D\u8FBC\u307E\u308C\u305F\u53CB\u4EBA\u305F\u3061\u3084\u59B9\u304C\u3053\u306E\u65E5\u8A8C\u3092\u307F\u3066\u4FFA\u306E\u4F53\u9A13\u3068\u5411\u304B\u3046\u5148\u3092\u77E5\u3063\u3066\u3082\u3089\u3044\u305F\u3044\u70BA\u306B\u6B8B\u3057\u305F\u3082\u306E\u3060\u3002"
  - "\u4FFA\u306F\u3084\u3063\u3068\u9003\u3052\u5207\u3063\u305F\u3002\u3042\u306E\u5316\u3051\u7269\u304B\u3089\u8FFD\u3044\u304B\u3051\u3089\u308C\u308B\u6050\u6016\u3068\u6226\u3044\u7D9A\u3051\u308B\u3053\u3068\u7D043\u65E5\u3001\u4EBA\u9593\u306E\u751F\u547D\u6D3B\u52D5\u304C\u6B63\u5E38\u306B\u6A5F\u80FD\u3057\u3066\u308B\u304B\u3082\u602A\u3057\u3044\u72B6\u614B\u3067\u7CBE\u795E\u72B6\u614B\u3082\u307E\u3068\u3082\u3067\u306F\u306A\u304B\u3063\u305F\u3060\u308D\u3046\u306B\u3088\u304F\u4FFA\u306F\u8010\u3048\u304D\u3063\u305F\u3002"
  - "3\u65E5\u9593\u306E\u9593\u51FA\u4F1A\u3063\u305F\u4EBA\u9593\u306F2\u4EBA\u3044\u305F\u30021\u4EBA\u306F\u521D\u8001\u306E\u9811\u56FA\u306A\u7537\u6027\u3067\u4FFA\u304C\u5316\u3051\u7269\u306B\u906D\u9047\u3057\u305F\u3068\u3044\u3063\u3066\u3082\u805E\u304F\u8033\u3092\u6301\u3063\u3066\u304F\u308C\u306A\u304B\u3063\u305F\u3002"
  - "\u305D\u306E\u305B\u3044\u3067\u5F7C\u306F\u9003\u3052\u5834\u306E\u5C11\u306A\u3044\u90E8\u5C4B\u306E\u5965\u3067\u81EA\u885B\u968A\u304C\u6551\u52A9\u306B\u6765\u308B\u306E\u3092\u5F85\u3064\u3068\u8A00\u3063\u3066\u3044\u305F\u304C\u5316\u3051\u7269\u304C\u5F7C\u306E\u7C60\u57CE\u3059\u308B\u90E8\u5C4B\u306B\u5165\u3063\u3066\u884C\u304F\u306E\u3092\u898B\u3066\u304B\u3089\u306F\u4E00\u5EA6\u3082\u5F7C\u306E\u59FF\u3092\u898B\u3066\u3044\u306A\u3044\u3002"
  - "2\u4EBA\u76EE\u306F\u4E00\u7DD2\u306B\u90FD\u5E02\u4F1D\u8AAC\u306E\u5642\u3092\u8A66\u3057\u3066\u3057\u307E\u3063\u305F\u53CB\u4EBA\u3060\u3002\u9AD8\u6821\u304B\u3089\u306E\u53CB\u4EBA\u3067\u3068\u3066\u3082\u6C17\u306E\u3044\u3044\u5974\u3060\u3063\u305F\u2026\u2026\u3002\u6B63\u7FA9\u611F\u3082\u5F37\u304F\u67D4\u9053\u3092\u55DC\u3093\u3067\u3044\u305F\u305F\u3081\u304B\u3053\u306E\u6B6A\u306A\u72B6\u6CC1\u306B\u3082\u5C11\u3057\u843D\u3061\u7740\u3044\u3066\u3044\u305F\u3002"
  - "\u5F7C\u306F\u2026\u2026\u4FFA\u304C\u5316\u3051\u7269\u306B\u8FFD\u3044\u8A70\u3081\u3089\u308C\u3066\u3057\u307E\u3063\u305F\u3068\u304D\u306B\u5927\u58F0\u3092\u51FA\u3057\u3066\u81EA\u5206\u304B\u3089\u56EE\u306B\u306A\u3063\u3066\u3057\u307E\u3063\u305F\u3002\u5F7C\u306E\u53EB\u3073\u58F0\u304C\u805E\u3053\u3048\u3066\u3044\u306A\u3044\u3057\u3001\u5316\u3051\u7269\u3092\u305D\u308C\u4EE5\u964D\u898B\u308B\u3053\u3068\u3082\u306A\u304B\u3063\u305F\u305F\u3081\u4FFA\u306F\u3042\u3044\u3064\u304C\u751F\u304D\u3066\u3044\u308B\u3068\u3044\u3046\u50C5\u304B\u306A\u5E0C\u671B\u306B\u7E0B\u308A\u305F\u3044\u3002"
  - "\u3044\u305A\u308C\u306B\u305B\u3088\u3001\u3053\u3093\u306A\u5730\u4E0B\u306B\u7D9A\u304F\u9053\u304C\u3042\u308B\u306A\u3093\u3066\u601D\u3044\u3082\u3057\u306A\u304B\u3063\u305F\u3002\u304D\u3063\u3068\u4FFA\u3092\u52A9\u3051\u3066\u304F\u308C\u305F\u3042\u3044\u3064\u3082\u4F55\u3068\u304B\u3053\u306E\u5730\u4E0B\u3078\u306E\u9053\u3092\u898B\u3064\u3051\u3066\u9003\u3052\u5207\u3063\u305F\u306B\u9055\u3044\u306A\u3044\u3002\u4FFA\u306F\u3053\u306E\u5148\u304C\u3069\u3046\u306A\u3063\u3066\u3044\u3088\u3046\u3068\u3082\u4ECA\u307E\u3067\u7D4C\u9A13\u3057\u3066\u304D\u305F\u5730\u7344\u306E\u6642\u9593\u3088\u308A\u306F\u307E\u3057\u3060\u308D\u3046\u3002\u3053\u306E\u5148\u304C\u81EA\u5206\u306E\u77E5\u3063\u3066\u3044\u308B\u5149\u666F\u3060\u3068\u4FE1\u3058\u3066\u524D\u306B\u9032\u3082\u3046\u3002"
