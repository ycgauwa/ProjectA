  messages7:
  - "\uFF08\u4E00\u4F53\u3069\u308C\u3060\u3051\u306E\u6642\u9593\u304C\u7D4C\u3063\u305F\u3060\u308D\u3046\u304B\uFF09"
  - "\uFF08\u3042\u308C\u304B\u3089\u6570\u6642\u9593\u3001\u3044\u3084\u6570\u65E5\u304C\u7D4C\u904E\u3057\u305F\u306E\u304B\u2026\u2026\u6642\u9593\u9593\u9694\u3067\u3055\u3048\u3042\u3044\u307E\u3044\u3060\u3002\uFF09"
  - "\uFF08\u5E78\u3044\u306A\u3053\u3068\u306B\u5148\u307B\u3069\u306E\u6C11\u5BB6\u306E\u3088\u3046\u306A\u5316\u3051\u7269\u306B\u306F\u906D\u9047\u3057\u3066\u3044\u306A\u3044\u304C\u3001\u6674\u304C\u90E8\u5C4B\u304B\u3089\u51FA\u3066\u304F\u308B\u69D8\u5B50\u3082\u306A\u3044\u3002\u5927\u58F0\u3067\u547C\u3073\u304B\u3051\u3066\u3082\u58F0\u304C\u304B\u308C\u308B\u3060\u3051\u3067\u306A\u306B\u3082\u53CD\u5FDC\u306F\u7121\u304B\u3063\u305F\u3002\uFF09"
  - "\u6700\u60AA\u306E\u7D50\u679C\u304C\u4E00\u77AC\u3060\u3051\u9752\u5E74\u306E\u8133\u88CF\u3092\u3088\u304E\u308B"
