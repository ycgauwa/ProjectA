  chickenfailedMetamessages:
  - "\u300C\u3048\u3047\u2026\u2026\u3002\u304A\u3044\u3089\u306E\u601D\u3063\u305F\u4EE5\u4E0A\u306B\u4EBA\u9593\u306E\u982D\u304C\u60AA\u304F\u3066\u3073\u3063\u304F\u308A\u3057\u305F\u3088\u2026\u2026\u3002\u300D"
  - "\u300C!?\u3044\u304D\u306A\u308A\u4F55\u3092\u8A00\u3044\u51FA\u3059\u3093\u3060!?\u305D\u3093\u306A\u3044\u304D\u306A\u308A\u99AC\u9E7F\u306B\u3055\u308C\u308B\u3088\u3046\u306A\u4E8B\u3092\u3057\u305F\u899A\u3048\u306F\u306A\u3044\u305E!\u300D"
  - "\u300C\u305D\u3093\u306A\u4E8B\u3063\u3066\u3042\u308B\u306F\u305A\u304C\u2026\u2026?\u3048\u3001\u4EBA\u9593\u306F\u899A\u3048\u3066\u306A\u3044\u306E?\u3055\u3063\u304D\u304A\u3044\u3089\u305F\u3061\u304C\u3057\u305F\u3053\u3068\u3092\u2026\u2026\u3002\u300D"
  - "\u300C\u3055\u3063\u304D?\u3044\u3084\u5168\u304F\u899A\u3048\u3066\u3044\u306A\u3044\u3093\u3060\u304C\u3002\u3082\u3057\u304B\u3057\u3066\u4F55\u304B\u3057\u305F\u306E\u304B?\u300D"
  - "\u300C\u305F\u304F\u3055\u3093\u3057\u305F\u3088!!\u304A\u3044\u3089\u305F\u3061\u4E09\u4EBA\u3067\u541B\u306E\u4E8B\u3092\u3050\u3061\u3083\u3050\u3061\u3083\u306B\u2026\u2026\u300D"
  - "\u300C\u304A\u3044\u3063\uFF01\uFF01\uFF01\uFF01\uFF01\u300D"
  - "\u300C\u3072\u3063\u2026!\u3042\u2026\u2026\u305D\u3046\u3060\u3063\u305F\u3084\u3002\u5FD8\u308C\u3066\u305F\u304B\u3089\u2026\u2026\u300D"
  - "\u300C\u983C\u3080\u305E\u2026\u2026\u3002\u5F7C\u306F\u307E\u3060\u7406\u89E3\u3057\u3066\u3044\u306A\u3044\u3002\u305D\u308C\u304C\u3069\u3046\u3044\u3046\u4E8B\u304B\u306F\u7406\u89E3\u3057\u3066\u3044\u308B\u3060\u308D\u3046?\u300D"
  - "\u300C\u3046..\u3046\u3093\u3002\u3053\u308C\u306F\u304A\u3044\u3089\u304C\u60AA\u304B\u3063\u305F\u3088\u2026\u2026\u3002\u3082\u3046\u3053\u306E\u8A71\u306F\u3084\u3081\u3066\u3082\u3044\u3044\u3088\u306A?\u4EBA\u9593!\u304A\u3044\u3089\u304A\u306A\u304B\u3059\u3044\u305F\u3088\u2026\u2026\u300D"
  - "\u300C\u305D\u3046\u3044\u3048\u3070\u5143\u3005\u306F\u6599\u7406\u3092\u6E21\u3059\u3063\u3066\u8A71\u3060\u3063\u305F\u306A\u3002\u3044\u3044\u305E\u6599\u7406\u3092\u4F5C\u3063\u3066\u304D\u305F\u304B\u3089\u4ECA\u98DF\u308F\u305B\u3066\u3084\u308B\u3002\u300D"
