  messages2:
  - "\uFF08\u4EBA\u304C\u5165\u308B\u3053\u3068\u306E\u3067\u304D\u308B\u307B\u3069\u5927\u304D\u306A\u53CE\u7D0D\u68DA\u3060\u3002\uFF09"
