  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  seimessages: []
  seinames: []
  seiimages: []
  sentences:
  - "\u300C\u3053\u306E\u6751\u306B\u4F4F\u307F\u59CB\u3081\u3066\u304B\u3089\u3082\u3046\u5C11\u3057\u3067\u534A\u5E74\u304C\u7D4C\u904E\u3059\u308B\u3002\u521D\u671F\u304B\u3089\u8584\u3005\u306F\u611F\u3058\u3066\u3044\u305F\u304C\u3001\u3053\u306E\u6751\u306B\u602A\u3057\u3055\u3092\u611F\u3058\u3066\u304D\u305F\u3002\u300D"
  - "\u300C\u6700\u8FD1\u4ED6\u306E\u6751\u4EBA\u9054\u304C\u79C1\u305F\u3061\u5BB6\u65CF\u306B\u5411\u3051\u308B\u76EE\u304C\u4EE5\u524D\u3068\u306F\u7570\u306A\u308A\u304A\u304B\u3057\u306A\u3082\u306E\u306B\u306A\u3063\u3066\u3044\u308B\u3002\u4F8B\u3048\u3070\u52D5\u7269\u3092\u898B\u308B\u3088\u3046\u306A\u3001\u305F\u307E\u306B\u54C0\u308C\u3080\u3088\u3046\u306A\u76EE\u7DDA\u3092\u9001\u308B\u4EBA\u304C\u3044\u308B\u300D"
  - "\u300C\u6700\u65E9\u3053\u306E\u6751\u3067\u4FE1\u3058\u3089\u308C\u308B\u306E\u306F\u3053\u306E\u6751\u306B\u4F4F\u3080\u524D\u304B\u3089\u306E\u533B\u8005\u306E\u53CB\u4EBA\u3060\u3051\u3060\u3002\u5F7C\u306B\u81EA\u5206\u304C\u611F\u3058\u305F\u3082\u306E\u3001\u305D\u3057\u3066\u3053\u308C\u304B\u3089\u8D77\u3053\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u7570\u5909\u306B\u3064\u3044\u3066\u5168\u3066\u4F1D\u3048\u3066\u304A\u3044\u305F\u3002\u300D"
  - "\u300C\u3082\u3046\u79C1\u305F\u3061\u306F\u9577\u304F\u306A\u3044\u304B\u3082\u3057\u308C\u306A\u3044\u3001\u305D\u3046\u306A\u308B\u524D\u306B\u9003\u3052\u308B\u6E96\u5099\u306F\u6574\u3048\u3066\u304A\u304F\u304C\u3001\u3082\u3057\u9593\u306B\u5408\u308F\u306A\u304B\u3063\u305F\u5834\u5408\u53CB\u4EBA\u3060\u3051\u3067\u3082\u52A9\u304B\u308B\u3088\u3046\u306B\u3002\u4ECA\u307E\u3067\u306F\u79C1\u9054\u304C\u52A9\u3051\u3066\u3082\u3089\u3063\u305F\u5206\u4ECA\u5EA6\u306F\u79C1\u304C\u5F7C\u3092\u52A9\u3051\u306A\u3051\u308C\u3070\u3044\u3051\u306A\u3044\u3002\u300D"
