  messages5:
  - "\u300C\u3053\u306E\u9332\u97F3\u3092\u8AB0\u304C\u805E\u3044\u3066\u3044\u308B\u304B\u306F\u5206\u304B\u3089\u306A\u3044\u304C\u3001\u4FFA\u304C\u767A\u898B\u3057\u305F\u6398\u524A\u6A5F\u306E\u60C5\u5831\u306B\u3064\u3044\u3066\u8A71\u3057\u3066\u3044\u3053\u3046\u3068\u601D\u3046\u3002\u300D"
  - "\u300C\u4FFA\u306F\u3053\u306E\u6C11\u5BB6\u3068\u5751\u9053\u3092\u629C\u3051\u305F\u5148\u306B\u3042\u308B\u6C11\u5BB6\u3092\u3069\u3063\u3061\u3082\u63A2\u7D22\u3057\u305F\u3053\u3068\u304C\u3042\u308B\u304C\u3069\u3061\u3089\u3082\u5316\u3051\u7269\u306B\u8105\u304B\u3055\u308C\u305F\u74B0\u5883\u3060\u3063\u305F\u3002\u300D"
  - "\u300C\u3060\u304B\u3089\u3053\u305D\u3001\u4FFA\u3082\u305D\u3046\u3060\u3057\u3053\u306E\u9332\u97F3\u3092\u805E\u3044\u3066\u3044\u308B\u4EBA\u3082\u76EE\u6307\u3057\u3066\u3044\u308B\u306E\u306F\u3001\u5751\u9053\u306E\u3055\u3089\u306B\u5965\u306B\u3042\u308B\u5927\u5CA9\u3092\u7834\u58CA\u3057\u3066\u5148\u3078\u3068\u9032\u3080\u3053\u3068\u3060\u308D\u3046\u3002\u300D"
  - "\u300C\u3053\u3053\u3088\u308A\u3082\u5B89\u5168\u306A\u3001\u305D\u3046\u3058\u3083\u306A\u304F\u3068\u3082\u8131\u51FA\u306E\u624B\u304C\u304B\u308A\u3092\u63A2\u3057\u3066\u3002\u300D"
  - "\u300C\u809D\u5FC3\u306E\u6398\u524A\u6A5F\u3060\u304C\u3001\u3053\u306E\u90E8\u5C4B\u306E\u5B9D\u7BB1\u306B\u3057\u307E\u3063\u3066\u3042\u308B\u305D\u3046\u3060\u3002\u300D"
  - "\u300C\u3082\u3057\u304B\u3057\u305F\u3089\u30D1\u30B9\u30EF\u30FC\u30C9\u304C\u5FC5\u8981\u304B\u3082\u3057\u308C\u306A\u3044\u304B\u3089\u63A2\u7D22\u3057\u3066\u5F97\u3089\u308C\u305F\u30D2\u30F3\u30C8\u3082\u3053\u3053\u3067\u4F1D\u3048\u3088\u3046\u3068\u601D\u3046\u3002\u300D"
  - "\u300C\u30D2\u30F3\u30C8\u306F\u30FC\u30FC\u30FC\u3055\u30FC\u30FC\u3066\u30FC\u30FC\u306E\u30FC\u30FC\u3060\u3002\u300D"
  - "\u97F3\u58F0\u306F\u4E0D\u81EA\u7136\u306B\u9014\u5207\u308C\u3066\u304A\u308A\u805E\u304D\u53D6\u308C\u306A\u304B\u3063\u305F"
  - "\u300C\u305D\u3046\u3044\u3046\u308F\u3051\u3060\u3002\u304A\u4E92\u3044\u3001\u751F\u304D\u3066\u4F1A\u3048\u305F\u3089\u826F\u3044\u306A\u2026\u2026\u3002\u300D"
