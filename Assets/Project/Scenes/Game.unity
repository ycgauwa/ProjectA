  - "\u300C\u307E\u3055\u304B\u3053\u3053\u306B\u98DB\u3070\u3055\u308C\u3066\u304B\u3089\u5E78\u4EBA\u541B\u306B\u51FA\u4F1A\u3048\u308B\u306A\u3093\u3066\u601D\u3063\u3066\u3082\u306A\u304B\u3063\u305F\u3088!\u300D"
  - "\u300C\u77E5\u3089\u306A\u3044\u5834\u6240\u306B\u98DB\u3070\u3055\u308C\u3066\u672C\u5F53\u306B\u4E0D\u5B89\u306E\u9023\u7D9A\u3060\u3063\u305F\u3051\u3069\u77E5\u3063\u3066\u308B\u4EBA\u304C\u3044\u3066\u304F\u308C\u3066\u3059\u3054\u3044\u5B89\u5FC3\u3067\u304D\u305F!\u300D"
  - "\u300C\u8272\u3005\u3068\u8A71\u3057\u305F\u3044\u3053\u3068\u306F\u3042\u308B\u3068\u601D\u3046\u3051\u3069\u5E78\u4EBA\u541B\u306F\u50D5\u306B\u4F55\u304B\u805E\u304D\u305F\u3044\u3053\u3068\u3068\u304B\u306F\u3042\u308B\uFF1F\u300D"
