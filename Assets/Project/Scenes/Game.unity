  topButtonMessages:
  - "\u3068\u3042\u308B\u5973\u6027\u30E2\u30C7\u30EBA\u306E\u8A18\u9332\u304C\u307E\u3068\u3081\u3089\u308C\u3066\u3044\u308B\u3002"
  - "2\u670810\u65E5\u30C7\u30D3\u30E5\u30FC\u4F5C\u767A\u8868\u3002"
  - "\u8857\u4E2D\u3067\u64AE\u3089\u308C\u305F\u5F7C\u5973\u306E\u7F8E\u3057\u3044\u59FF\u304C\u8A71\u984C\u3068\u306A\u308A\u4EBA\u6C17\u304C\u6025\u4E0A\u6607\u3057\u305F\u3002"
  - "\u305D\u306E\u6CE2\u306B\u7D9A\u3044\u3066\u305D\u306E\u534A\u5E74\u5F8C\u306B\u5F7C\u5973\u306E2\u4F5C\u76EE\u3068\u306A\u308B\u4F5C\u54C1\u304C\u767A\u8868\u3055\u308C\u305F\u3002"
  - "\u305D\u306E\u4F5C\u54C1\u306B\u3066\u5F7C\u5973\u306F\u6570\u591A\u304F\u306E\u30E1\u30C7\u30A3\u30A2\u306B\u59FF\u3092\u3055\u3089\u3059\u304D\u3063\u304B\u3051\u3068\u306A\u308B\u3002"
  - "\u5F7C\u5973\u306F\u6700\u5F8C\u306E\u4F5C\u54C1\u306F\u305D\u306E\u5E74\u306E11\u6708\u306B\u751F\u307E\u308C\u6545\u90F7\u3067\u3042\u308B\u30A4\u30AE\u30EA\u30B9\u306E\u6D77\u6CBF\u3044\u3067\u64AE\u5F71\u3055\u308C\u305F\u3002"
  - "\u4EBA\u6C17\u7D76\u9802\u4E2D\u3060\u3063\u305F\u5F7C\u5973\u306F\u305D\u306E\u4F5C\u54C1\u3092\u6700\u5F8C\u306B\u59FF\u3092\u6D88\u3057\u305F\u306E\u3067\u3042\u308B\u3002\u4E00\u4F53\u3069\u3053\u3078\u884C\u3063\u305F\u306E\u304B\u8AB0\u306B\u3082\u77E5\u3089\u308C\u3066\u306F\u3044\u306A\u3044\u3002"
