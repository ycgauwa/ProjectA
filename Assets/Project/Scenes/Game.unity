  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - "\u300C\u3088\u3057\u3001\u7206\u5F3E\u3082\u5165\u624B\u3057\u305F\u3053\u3068\u3060\u3057\u5F8C\u306F\u5751\u9053\u306B\u5411\u304B\u3046\u3060\u3051\u306B\u306A\u3063\u305F\u306A\u3002\u300D"
  - "\uFF08\u3053\u306E\u7206\u5F3E\u306E\u97F3\u3067\u5751\u9053\u306B\u307E\u3067\u3042\u306E\u5316\u3051\u72AC\u304C\u8FFD\u3044\u304B\u3051\u3066\u3053\u306A\u3051\u308C\u3070\u3044\u3044\u3093\u3060\u304C\u306A\u2026\u2026\uFF09"
  - "\u300C!!\u300D"
  - "\u300C\u2026\u2026\u4F55\u304B\u304F\u308B\u3063!\u300D"
  - "\uFF08\u8AB0\u3060\uFF1F\u4EBA\u9593\u304B\uFF1F\u305D\u308C\u3068\u3082\u3055\u3063\u304D\u306E\u5316\u3051\u72AC\u306A\u306E\u304B\uFF1F\uFF09"
  names:
  - "\u5E78\u4EBA"
  - "\u5E78\u4EBA"
  - "\u5E78\u4EBA"
  - "\u5E78\u4EBA"
  - "\u5E78\u4EBA"
  image:
  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  messages2:
  - "\u300C\u306A\u3093\u3060\u6674\u304B! \u5909\u306B\u7DCA\u5F35\u3057\u3061\u3083\u3063\u305F\u3088\u3002\u300D"
  - "\u300C\u3078\u3078\u30FC\u3002\u50D5\u3067\u3057\u305F\uFF01\u300D"
  names2:
  - "\u5E78\u4EBA"
  - "\u6674"
  image2:
  - {fileID: 21300000, guid: f9874f60958ea9944bd9c8b2d0d959cb, type: 3}
  - {fileID: 21300000, guid: e9cf0302651812b4599858124a79e686, type: 3}
  messages3:
  - "\u300C\u3042\u306F\u306F\u3001\u3054\u3081\u3093\u3054\u3081\u3093\u3002\u4E0A\u3067\u4EBA\u3063\u307D\u3044\u8DB3\u97F3\u304C\u805E\u3053\u3048\u305F\u304B\u3089\u3082\u3046\u4E0A\u3067\u63A2\u7D22\u3067\u304D\u308B\u3088\u3046\u306B\u306A\u3063\u305F\u306E\u304B\u306A\u3063\u3066\u300D"
  - "\u300C\u30D0\u30AB\u305F\u308C\u3001\u3082\u3046\u63A2\u7D22\u306F\u7D42\u308F\u3063\u305F\u3088\u3002\u3042\u3068\u306F\u3053\u306E\u6C11\u5BB6\u3092\u51FA\u3066\u5751\u9053\u306B\u5411\u304B\u3046\u3060\u3051\u3060\u3002\u300D"
  - "\u300C\u3048!? \u65E9\u304F\u306A\u3044!? \u50D5\u307E\u3060\u4F55\u3082\u8ABF\u3079\u3089\u308C\u3066\u306A\u3044\u3093\u3060\u3051\u3069\u2026\u2026\u300D"
  - "\u300C\u5225\u306B\u30D4\u30AF\u30CB\u30C3\u30AF\u306B\u6765\u3066\u308B\u308F\u3051\u3058\u3083\u306A\u3044\u3093\u3060\u3002\u3084\u3063\u3071\u308A\u3053\u306E\u6C11\u5BB6\u306B\u3082\u5316\u3051\u7269\u306F\u4F4F\u3093\u3067\u3044\u305F\u307F\u305F\u3044\u3060\u3057\u4E00\u523B\u3082\u65E9\u304F\u51FA\u305F\u3044\u3093\u3060\u3088\u3002\u300D"
  - "\u300C\u898B\u305F\u3053\u3068\u306F\u306A\u3044\u3051\u3069\u3084\u3063\u3071\u308A\u305D\u3046\u3044\u3046\u5B58\u5728\u306F\u3044\u308B\u3093\u3060\u306D\u3002\u300D"
  - "\u300C\u6674\u3082\u898B\u3066\u307F\u305F\u3089\u5206\u304B\u308B\u3051\u3069\u3001\u5922\u306B\u51FA\u3066\u304F\u308B\u306A\u3093\u3066\u3082\u3093\u3058\u3083\u306A\u3044\u305E\u3002\u4FFA\u306F2\u5EA6\u3068\u4F1A\u3044\u305F\u304F\u306A\u3044\u3002\u300D"
  - "\uFF08\u5E78\u4EBA\u541B\u306B\u306F\u5185\u7DD2\u3060\u3051\u3069\u3001\u3061\u3087\u3063\u3068\u8208\u5473\u3042\u308B\u306A\u3041\u2026\u2026\u3002\u3069\u3093\u306A\u59FF\u3057\u3066\u308B\u3093\u3060\u308D\u3046\uFF1F\uFF09"
  - "\u300C\u3068\u306B\u304B\u304F\u3001\u3082\u3046\u6025\u3044\u3067\u5411\u304B\u304A\u3046\u3002\u3053\u3053\u3067\u8A71\u3057\u3066\u3044\u3066\u3082\u3057\u3087\u3046\u304C\u306A\u3044\u3057\u306A\u3002\u300D"
  - "\u300C\u3046\u3093\uFF01\u305D\u3046\u3060\u306D\u3002\u300D"
