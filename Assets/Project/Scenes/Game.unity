  - {fileID: 0}
  - {fileID: 0}
  sentences:
  - "\u3044\u3063\u305F\u3044\u4FFA\u306F\u3069\u3053\u3067\u9078\u629E\u3092\u9593\u9055\u3048\u3066\u3057\u307E\u3063\u305F\u3093\u3060\u308D\u3046\u304B\u3002\u3082\u3046\u89AA\u3057\u304B\u3063\u305F\u3042\u3044\u3064\u3068\u306E\u53CB\u60C5\u3082\u6700\u65E9\u5931\u308F\u308C\u3066\u3057\u307E\u3063\u305F\u3002"
  - "\u3053\u3046\u3044\u3063\u305F\u3053\u3068\u306F\u305F\u3044\u3066\u3044\u304A\u4E92\u3044\u306E\u52D8\u9055\u3044\u3084\u8A8D\u8B58\u306E\u3059\u308C\u9055\u3044\u304B\u3089\u8D77\u3053\u308B\u3088\u3046\u306A\u4E8B\u3060\u304C\u3001\u4ECA\u56DE\u306E\u4EF6\u3067\u306F\u305D\u308C\u306F\u671F\u5F85\u304C\u3067\u304D\u306A\u3044\u3002"
  - "\u5B50\u4F9B\u306E\u3053\u308D\u304B\u3089\u306E\u4EF2\u3060\u3063\u305F\u3002\u3053\u306E\u6751\u3067\u80B2\u3063\u305F\u4FFA\u305F\u3061\u306F\u6BCE\u65E5\u3092\u5171\u306B\u904E\u3054\u3057\u305F\u3002\u3068\u3066\u3082\u8F1D\u304B\u3057\u3044\u65E5\u3005\u3060\u3063\u305F\u3002"
  - "\u3042\u3044\u3064\u304C\u4E21\u89AA\u306E\u4E8B\u60C5\u3067\u3053\u306E\u6751\u3092\u96E2\u308C\u308B\u3068\u805E\u3044\u305F\u6642\u306B\u306F\u306E\u3069\u304C\u67AF\u308C\u308B\u307B\u3069\u6CE3\u304D\u53EB\u3093\u3060\u3057\u3001\u65B0\u305F\u306A\u5BB6\u65CF\u3092\u9023\u308C\u3066\u623B\u3063\u3066\u304D\u305F\u3068\u304D\u306B\u306F\u672C\u5F53\u306B\u6D99\u304C\u6B62\u307E\u3089\u306A\u304B\u3063\u305F\u3002"
  - "\u3051\u3069\u305D\u3093\u306A\u61D0\u304B\u3057\u3044\u601D\u3044\u51FA\u8A71\u3082\u904E\u53BB\u306E\u8A71\u3060\u3002\u4FFA\u305F\u3061\u306E\u9593\u306B\u306F\u3069\u3046\u3057\u3088\u3046\u3082\u306A\u3044\u4E80\u88C2\u304C\u751F\u307E\u308C\u3066\u3057\u307E\u3063\u305F\u3002"
  - "\u6751\u306E\u5965\u3067\u5BC6\u304B\u306B\u884C\u308F\u308C\u3066\u4EBA\u4F53\u5B9F\u9A13\u306E\u69D8\u5B50\u3092\u898B\u3089\u308C\u3066\u3057\u307E\u3063\u305F\u3002\u8CAC\u4EFB\u8005\u3068\u3057\u3066\u4E0A\u306B\u5831\u544A\u3092\u3057\u3001\u3042\u3044\u3064\u3092\u6BBA\u3055\u306A\u304F\u3066\u306F\u2026\u2026\u3002"
  - "\u5B9F\u9A13\u304C\u9032\u3080\u306B\u3064\u308C\u96E3\u8272\u3092\u793A\u3059\u4FFA\u306B\u6751\u9577\u305F\u3061\u306F\u4FFA\u306E\u5BB6\u65CF\u3092\u4EBA\u8CEA\u306B\u53D6\u308A\u3084\u304C\u3063\u305F\u3002\u3082\u3046\u5F8C\u623B\u308A\u306F\u51FA\u6765\u306A\u3044\u3093\u3060\u3002\u3059\u307E\u306A\u3044\u2026\u2026\u4FFA\u306E\u5BB6\u65CF\u306E\u305F\u3081\u306B\u72A0\u7272\u306B\u306A\u3063\u3066\u304F\u308C"
  dates:
  - "\uFF11\u6708\uFF11\uFF15\u65E5"
  - "\uFF11\u6708\uFF11\uFF15\u65E5"
