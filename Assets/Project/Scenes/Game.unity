  messages:
  - "\u3053\u306E\u306C\u3044\u3050\u308B\u307F\u306F\u4E00\u4F53\u2026\u2026\uFF1F"
  - "\u300C\u3084\u3042\uFF01\u3053\u3093\u306B\u3061\u308F\uFF01\u4E45\u3005\u306B\u4EBA\u9593\u3092\u307F\u305F\u3088\uFF01\u300D"
  - "\uFF08\u306C\u3044\u3050\u308B\u307F\u304C\u558B\u3063\u305F\uFF01\uFF1F\uFF09"
  - "\u300C\u541B\u4ECA\u6687\u3057\u3066\u305D\u3046\u3060\u3057\u304A\u3044\u3089\u306E\u8A71\u805E\u3044\u3066\u3044\u3063\u3066\u3088\uFF01\u300D"
  - "\u300C\u672C\u6765\u306F\u304A\u3044\u3089\u305F\u3061\u96DB\u9CE5\u306B\u89AA\u304C\u990C\u3092\u3068\u3063\u3066\u304D\u3066\u4E0E\u3048\u3066\u304F\u308C\u308B\u306F\u305A\u306A\u306E\u306B\u3001\u3042\u3044\u3064\u3089\u306F\u3001\u3001\u3001\u300D"
  - "\uFF08\u52DD\u624B\u306B\u8A71\u3057\u59CB\u3081\u305F\u3001\u3001\u62D2\u5426\u6A29\u306F\u306A\u3055\u305D\u3046\u3060\u306A\u3002\uFF09"
  - "\u300C\u3042\u3044\u3064\u3089\u306F\u3001\u3001\u304A\u3044\u3089\u305F\u3061\u306E\u5206\u307E\u3067\u98EF\u3092\u98DF\u3079\u3084\u304C\u3063\u305F\u3093\u3060\uFF01\u304A\u304B\u3052\u3067\u5144\u5F1F\u305F\u3061\u306F\u307F\u3093\u306A\u9913\u6B7B\u3057\u3061\u307E\u3063\u305F\u3093\u3060\uFF01\u300D"
