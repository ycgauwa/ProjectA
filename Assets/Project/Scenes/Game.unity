  - "\u300C\u2026\u2026\u3048\uFF1F\u300D"
  - "\u300C\u3048\uFF1F\u3058\u3083\u306D\u3048\u3093\u3060\u3088\u3002\u76EE\u4E0A\u306E\u4EBA\u3078\u306E\u793C\u5100\u3082\u4FA1\u5024\u306E\u3042\u308B\u3082\u306E\u306B\u5BFE\u3057\u3066\u5BFE\u4FA1\u3092\u652F\u6255\u3046\u3053\u3068\u3082\u5B66\u6821\u3067\u306F\u6559\u3048\u3066\u304F\u308C\u306A\u304B\u3063\u305F\u306E\u304B\uFF1F\u300D"
