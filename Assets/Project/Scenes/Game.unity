  messages4:
  - "\u5E8A\u3068\u306E\u9AD8\u3055\u306F\u6C7A\u3057\u3066\u4F4E\u3044\u308F\u3051\u3067\u306F\u306A\u304B\u3063\u305F\u305F\u3081\u3001\u5E78\u4EBA\u304C\u7740\u5730\u3092\u3057\u3066\u5927\u304D\u306A\u843D\u4E0B\u97F3\u304C\u5468\u308A\u306B\u97FF\u304F\u3002"
  - "\u300C\u5653\u3001\u672C\u5F53\u306B\u964D\u308A\u3061\u3083\u3063\u305F\u2026\u2026\u3002\u300D"
  - "\u300C\u5E78\u4EBA\u541B\u5927\u4E08\u592B!?\u300D"
  - "\u300C\u2026\u2026\u2026\u2026\u3042\u3041!\u3056\u3063\u3068\u5468\u308A\u3092\u898B\u3066\u307F\u305F\u3051\u3069\u4ECA\u306E\u5E8A\u5927\u4E08\u592B\u305D\u3046\u3060!\u3042\u306E\u5316\u3051\u7269\u306E\u8DB3\u97F3\u3082\u4ECA\u306E\u3068\u3053\u308D\u805E\u3053\u3048\u306A\u3044!\u300D"
  - "\uFF08\u5927\u4E08\u592B\u305D\u3046\u3067\u826F\u304B\u3063\u305F\u2026\u2026\uFF09"
  - "\u300C\u3058\u3083\u3042\u6674\u3082\u964D\u308A\u3066\u3053\u3044!\u300D"
  - "\u300C\u3048!?\u3067\u3082\u3061\u3087\u3063\u3068\u9AD8\u304F\u306A\u3044?\u4F55\u304B\u68AF\u5B50\u3068\u304B\u306F\u2026\u2026\u300D"
  - "\u300C\u305D\u3093\u306A\u306E\u306A\u3044!\u3044\u3044\u304B\u3089\u65E9\u304F\u3057\u3066\u304F\u308C!\u6B63\u76F4\u4FFA\u3082\u3044\u3064\u3042\u306E\u5316\u3051\u7269\u304C\u6765\u308B\u304B\u308F\u304B\u3089\u306A\u304F\u3066\u6016\u3044\u3093\u3060\u3063!!\u300D"
  - "\u300C\u3046\u2026\u2026\u5206\u304B\u3063\u305F\u3088\u3002\u964D\u308A\u308B\u304B\u3089\u53D7\u3051\u6B62\u3081\u3066\u306D\u3002\u300D"
