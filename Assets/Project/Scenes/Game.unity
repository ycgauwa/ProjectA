  messages2:
  - "\u300C\u7121\u4E8B\u4F55\u3068\u304B\u306A\u3063\u305F\u306A\u2026\u2026\u3002\u8089\u98DF\u3060\u3063\u305F\u304A\u304B\u3052\u304B\u3042\u306E\u5927\u304D\u306A\u8089\u306B\u98DF\u3044\u3064\u3044\u3066\u304F\u308C\u305F\u3002\u300D"
  - "\uFF08\u306B\u3057\u305F\u3063\u3066\u3053\u3044\u3064\u306F\u4E00\u4F53\u4F55\u306A\u3093\u3060\uFF1F\u898B\u305F\u3053\u3068\u3082\u306A\u3044\u751F\u7269\u3060\u3057\u982D\u306E\u69CB\u9020\u306A\u3093\u3066\u307E\u308B\u3067\u30A8\u30A4\u30EA\u30A2\u30F3\u3060\u2026\u2026\u3002\uFF09"
