  messages:
  - "\u672C\u68DA\u306E\u3088\u3046\u3060\u7279\u306B\u3081\u307C\u3057\u3044\u672C\u306F\u306A\u3044"
  - "\u300C\u3093\uFF1F\u306A\u3093\u3060\u3053\u308C\u306F\uFF1F\u300D"
  - "\u300C\u672C\u68DA\u306E\u4E2D\u306B\u4F55\u304B\u4E00\u518A\u6BDB\u8272\u306E\u9055\u3046\u3082\u306E\u304C\u53CE\u307E\u3063\u3066\u3044\u308B\u306A\u3002\u300D"
