  topButtonMessages:
  - "\u300C\u98DB\u3070\u3055\u308C\u305F\u5F8C\u306E\u3053\u3068\u2026\u2026\uFF1F\u50D5\u306F\u7279\u306B\u306A\u306B\u3082\u3057\u3066\u306A\u3044\u3088\uFF1F\u300D"
  - "\u300C\u63A2\u7D22\u3057\u3088\u3046\u304B\u306A\u3063\u3066\u601D\u3063\u305F\u3093\u3060\u3051\u3069\u30012\u968E\u306B\u884C\u3053\u3046\u3068\u3057\u3066\u3082\u3044\u3051\u306A\u3044\u3093\u3060\u3088!\u300D"
  - "\uFF08\u884C\u3051\u306A\u3044\uFF1F\u884C\u304B\u306A\u3044\u3058\u3083\u306A\u304F\u3066\u884C\u3051\u306A\u3044\u306E\u304C\u5F15\u3063\u304B\u304B\u308B\u306A\u2026\u2026\u3002\uFF09"
  - "\u5F15\u3063\u304B\u304B\u308B\u7269\u8A00\u3044\u306B\u50C5\u304B\u306A\u304C\u3089\u602A\u8A1D\u306A\u8868\u60C5\u304C\u8868\u306B\u51FA\u3066\u3057\u307E\u3046\u3002"
  - "\u300C\u3042\u3063!\u5E78\u4EBA\u541B\u4FE1\u3058\u3066\u306A\u3044\u3067\u3057\u3087\u30FC\uFF01\u602A\u3057\u3093\u3067\u308B\u9854\u3057\u3066\u308B\u3088\uFF01\u672C\u5F53\u306B\u9032\u3081\u306A\u3044\u306E\u306B\u7591\u3046\u306A\u3089\u81EA\u5206\u3067\u78BA\u304B\u3081\u306A\u3088!\u300D"
  - "\u300C\u306F\u306F\u2026\u2026\u3054\u3081\u3093\u3054\u3081\u3093\u3002\u3067\u3082\u884C\u3051\u306A\u3044\u304C\u6C17\u306B\u306A\u3063\u3061\u3083\u3063\u3066\u3055\u3002\u30C9\u30A2\u304C\u52D5\u304B\u306A\u3044\u3068\u304B\uFF1F\u300D"
  - "\u300C\u3046\u3093\u3002\u305D\u3093\u306A\u611F\u3058\u3060\u3088\u3002\u3067\u3082\u30C9\u30A2\u30CE\u30D6\u3082\u30D4\u30AF\u30EA\u3068\u3057\u306A\u304B\u3063\u305F\u306E\u306F\u3073\u3063\u304F\u308A\u3057\u305F\u306D\u3002\u30C9\u30A2\u306E\u5411\u304B\u3044\u5074\u3067\u8AB0\u304B\u304C\u6291\u3048\u3066\u305F\u308A\u3057\u3066\uFF1F\u300D"
  - "\u300C\u304A\u3044\u3001\u3053\u308C\u304B\u3089\u63A2\u7D22\u3059\u308B\u3063\u3066\u306E\u306B\u5909\u306A\u3053\u3068\u8A00\u3046\u306A\u3088\u3002\u300D"
  - "\u300C\u3075\u3075\u3093\u3002\u3055\u3063\u304D\u7591\u308F\u308C\u305F\u304B\u3089\u305D\u306E\u4ED5\u8FD4\u3057\u3060\u3088\u30FC!\u300D"
  - "\uFF08\u3053\u3044\u3064\u7570\u5E38\u306A\u72B6\u6CC1\u306A\u306E\u306B\u7DCA\u5F35\u611F\u304C\u306A\u3044\u306A\u2026\u2026\u3002\u304A\u304B\u3052\u3055\u307E\u3067\u3053\u3063\u3061\u3082\u30EA\u30E9\u30C3\u30AF\u30B9\u51FA\u6765\u3066\u308B\u3057\u611F\u8B1D\u3057\u3068\u304F\u304B\u3002\uFF09"
  - "\u300C\u6674\u3001\u3042\u308A\u304C\u3068\u3046\u3002\u300D"
  - "\u300C\u3093\uFF1F\u307E\u3041\u307E\u3041\u2026\u2026\u3069\u3046\u3044\u305F\u3057\u307E\u3057\u3066!!\u300D"
  - "\uFF082\u968E\u3078\u306E\u9053\u306F\u3069\u3046\u306B\u304B\u3057\u3066\u901A\u308B\u65B9\u6CD5\u3092\u898B\u3064\u3051\u51FA\u3055\u306A\u3044\u3068\u306A\u3002\u899A\u3048\u3066\u304A\u304F\u304B\u3002\uFF09"
