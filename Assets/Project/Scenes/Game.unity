  - "\u3072\u3088\u3053\u306E\u306C\u3044\u3050\u308B\u307F\u306F\u3069\u3046\u3084\u3063\u3066\u304B\u98DF\u7269\u3092\u53E3\u306B\u904B\u3073\u9759\u304B\u306B\u5480\u56BC\u3057\u3066\u3044\u308B\u3002\u3057\u304B\u3057\u6BB5\u3005\u3068\u7709\u304C\u3072\u305D\u3081\u3089\u308C\u3066\u3044\u304F\u3002"
  - "\u300C\u2026\u2026\u3046\u3063\u3002\u307E\u305A\u3044\u3063\u2026\u2026\u3002\u304A\u3047\u3002\u300D"
