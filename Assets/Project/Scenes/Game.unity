  - "\u300C\u306F\u3041\uFF1F\u4F55\u3092\u3044\u3063\u3066\u308B\u3093\u3060\uFF1F\u3069\u3053\u304B\u3089\u3069\u3046\u307F\u3066\u3082\u4FFA\u306F\u4EBA\u9593\u3060\u308D\u300D"
  - "\u300C\u306A\u3001\u306A\u3041\uFF01\u304A\u3058\u3055\u3093\uFF01\u4FFA\u6C17\u3065\u3044\u305F\u3089\u3053\u3053\u306B\u3044\u3066\u53CB\u9054\u3068\u3082\u306F\u3050\u308C\u3061\u3083\u3063\u305F\u3093\u3060\u3088\uFF01\u306A\u3093\u304B\u77E5\u3063\u3066\u308B\u3053\u3068\u306A\u3044\u304B\uFF1F\u300D"
