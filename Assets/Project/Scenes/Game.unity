  messages5:
  - "\u300C\u75DB\u3063\u3066\u3066\u3001\u53D7\u3051\u6B62\u3081\u308B\u3063\u3066\u3088\u308A\u307B\u307C\u30AF\u30C3\u30B7\u30E7\u30F3\u307F\u305F\u3044\u306A\u4F7F\u3044\u65B9\u3057\u3084\u304C\u3063\u3066\u2026\u2026\u3002\u300D"
