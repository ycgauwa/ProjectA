  messages:
  - "\uFF08\u4F55\u304B\u843D\u3061\u3066\u3044\u308B\u307F\u305F\u3044\u3060\u2026\u2026\u3002\uFF09"
  - "\u300C\u3053\u308C\u306F\u2026\u2026\u65E5\u8A8C\u304B\uFF1F\u306A\u3093\u3067\u3053\u3093\u306A\u3068\u3053\u308D\u306B\u843D\u3061\u3066\u3044\u308B\u3093\u3060\u308D\u3046\u304B\u3002\u300D"
