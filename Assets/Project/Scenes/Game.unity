  m_Script: {fileID: 11500000, guid: b38754f425bac5b4495a6f680c118485, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - "\uFF08\u65E5\u8A18\u306E\u3088\u3046\u306A\u3082\u306E\u304C\u843D\u3061\u3066\u3044\u308B\u3002\uFF09"
  - "\u300C\u3053\u308C\u306F\u3053\u306E\u5BB6\u306E\u5BB6\u4E3B\u304C\u907A\u3057\u305F\u65E5\u8A18\u304B\u2026\u2026?\u300D"
  - "\uFF08\u304B\u306A\u308A\u5E74\u5B63\u304C\u5165\u3063\u3066\u3044\u3066\u8AAD\u307F\u3065\u3089\u3055\u306F\u3042\u308B\u304C\u4ED5\u65B9\u304C\u306A\u3044\u2026\u2026\u3002\uFF09"
  names:
  - "\u5E78\u4EBA"
  - "\u5E78\u4EBA"
  - "\u5E78\u4EBA"
  image:
  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  seimessages: []
  seinames: []
  seiimages: []
  sentences:
  - "\u79C1\u306F\u3053\u306E\u6751\u3067\u6065\u3058\u306C\u3088\u3046\u306B\u751F\u304D\u3066\u3044\u305F\u3002\u8FB2\u5BB6\u306E\u606F\u5B50\u3068\u3057\u3066\u80B2\u3061\u3001\u89AA\u304B\u3089\u4ED5\u4E8B\u3092\u5B66\u3073\u306A\u304C\u3089\u3057\u3063\u304B\u308A\u8005\u306E\u5E7C\u99B4\u67D3\u3092\u5AC1\u306B\u8FCE\u3048\u9806\u98A8\u6E80\u5E06\u306A\u3064\u3082\u308A\u3060\u3063\u305F\u3002"
  - "\u3057\u304B\u3057\u3001\u81EA\u6162\u3067\u3042\u3063\u305F\u306F\u305A\u306E\u4E00\u4EBA\u606F\u5B50\u304C\u3042\u308B\u65E5\u3092\u5883\u306B\u304A\u304B\u3057\u304F\u306A\u3063\u3066\u3057\u307E\u3063\u305F\u2026\u2026\u3002\u4F5C\u5BB6\u306B\u306A\u308B\u3093\u3060\u3068\u8A00\u3044\u59CB\u3081\u3066\u5BB6\u696D\u306E\u624B\u4F1D\u3044\u306E\u6642\u9593\u3092\u6E1B\u3089\u3057\u7A7A\u3044\u305F\u6642\u9593\u306F\u305A\u3063\u3068\u81EA\u5BA4\u306B\u3053\u3082\u308B\u3088\u3046\u306B\u306A\u3063\u3066\u3057\u307E\u3063\u305F\u3002"
  - "\u3053\u306E\u307E\u307E\u3044\u3051\u3070\u8FD1\u6240\u306E\u7B11\u3044\u3082\u306E\u306B\u306A\u308B\u306B\u9055\u3044\u306A\u3044\u3057\u6751\u9577\u306B\u3082\u76EE\u3092\u3064\u3051\u3089\u308C\u3066\u3057\u307E\u3046\u3002\u4ECA\u5EA6\u6A5F\u4F1A\u304C\u3042\u308C\u3070\u7121\u7406\u3084\u308A\u306B\u3067\u3082\u8A71\u3092\u805E\u304B\u306A\u3051\u308C\u3070\u306A\u2026\u2026\u3002"
  - "\u4ED5\u4E8B\u7D42\u308F\u308A\u306B\u81EA\u5BA4\u306B\u623B\u308D\u3046\u3068\u3059\u308B\u606F\u5B50\u3092\u5F15\u304D\u7559\u3081\u3066\u8A73\u3057\u304F\u8A71\u3092\u805E\u3044\u3066\u307F\u305F\u3089\u3068\u3093\u3067\u3082\u306A\u3044\u4E8B\u5B9F\u304C\u767A\u899A\u3057\u3066\u3057\u307E\u3063\u305F\u3002"
  - "\u307E\u305A\u606F\u5B50\u306F\u5143\u3005\u4F5C\u5BB6\u306B\u306A\u308A\u305F\u3044\u3068\u8584\u3005\u601D\u3063\u3066\u306F\u3044\u305F\u304C\u3001\u5BB6\u696D\u7D99\u304C\u306A\u3051\u308C\u3070\u3044\u3051\u306A\u3044\u30D7\u30EC\u30C3\u30B7\u30E3\u30FC\u304B\u3089\u305D\u306E\u3053\u3068\u3092\u8868\u7ACB\u3063\u3066\u8A00\u3048\u306A\u304B\u3063\u305F\u3089\u3057\u3044\u3002"
  - "\u305D\u3057\u3066\u305D\u306E\u60F3\u3044\u304C\u7206\u767A\u3057\u305F\u306E\u306F\u884C\u5546\u4EBA\u304C\u6301\u3063\u3066\u304D\u305F\u5C0F\u8AAC\u306B\u5F37\u304F\u5F71\u97FF\u3092\u53D7\u3051\u305F\u3068\u3044\u3046\u8A71\u3060\u3002\u69D8\u5B50\u3092\u898B\u308B\u306B\u305D\u306E\u5C0F\u8AAC\u306E\u4F5C\u8005\u306E\u4E8B\u3092\u5D07\u62DD\u3057\u3066\u304A\u308A\u81EA\u5206\u306E\u4F5C\u98A8\u3082\u66F8\u304D\u65B9\u3082\u8A2D\u5B9A\u3082\u305D\u3057\u3066\u540D\u524D\u3067\u3055\u3048\u3082\u305D\u306E\u4EBA\u304B\u3089\u5F37\u304F\u5F71\u97FF\u3092\u53D7\u3051\u3066\u3044\u308B\u3068\u3044\u3046\u8A71\u3092\u805E\u304B\u3055\u308C\u305F\u3002"
