  messages:
  - "\u672C\u68DA\u306E\u3088\u3046\u3060\u3002\u69D8\u3005\u306A\u30B8\u30E3\u30F3\u30EB\u306E\u672C\u304C\u7F6E\u304B\u308C\u3066\u3044\u308B\u3088\u3046\u3060\u3002"
  - "\u300C\u4F55\u304B\u624B\u304C\u624B\u304C\u304B\u308A\u306B\u306A\u308B\u3088\u3046\u306A\u672C\u306F\u306A\u3044\u306E\u304B\u2026\u2026\uFF1F\u300D"
  - "\u300C\u2026\u2026\u3093\uFF1F\u3053\u308C\u306F\u3053\u306E\u5BB6\u306E\u4EBA\u306E\u8A18\u9332\u306A\u306E\u304B\uFF1F\u305D\u308C\u3068\u3082\u8DA3\u5473\u2026\u2026\uFF1F\u300D"
