  messages3:
  - "\u300C\u3082\u3057\u304B\u3057\u3066\u5E78\u4EBA\u541B\u304B!\u3088\u304B\u3063\u305F\u30FC!\u300D"
  - "\u300C\u3042\u306E\u97F3\u697D\u5BA4\u304B\u3089\u307F\u3093\u306A\u3068\u306F\u3050\u308C\u3061\u3083\u3063\u3066\u3001\u5FC3\u914D\u3060\u3063\u305F\u3093\u3060\u3051\u3069\u5927\u4E08\u592B\u3060\u3063\u305F\uFF1F\u300D"
  - "\u300C\u3042\u3042\u2026\u2026\u4FFA\u306F\u5927\u4E08\u592B\u3060\u3063\u305F\u3051\u3069\u6674\u306F\u4F55\u304B\u5371\u306A\u3044\u76EE\u306B\u5408\u308F\u306A\u304B\u3063\u305F\u304B\uFF1F\u300D"
  - "\u300C\u3046\u3093!\u3053\u306E\u5BB6\u3082\u3061\u3087\u3063\u3068\u6B69\u3044\u3066\u307F\u305F\u3051\u3069\u8AB0\u3082\u3044\u306A\u3044\u3057\u4F55\u306B\u3082\u306A\u3055\u305D\u3046\u3060\u3063\u305F\u3088\u30FC\uFF1F\u300D"
  - "\uFF08\u3053\u306E\u5BB6\u306B\u306F\u3042\u306E\u5316\u3051\u7269\u306F\u3044\u306A\u3044\u306E\u304B\u2026\u2026\uFF1F\u305D\u308C\u3068\u3082\u305F\u307E\u305F\u307E\u3044\u306A\u3044\u3060\u3051\u3067\u3053\u308C\u304B\u3089\u73FE\u308C\u3066\u3082\u304A\u304B\u3057\u304F\u306A\u3044\u306E\u304B?\uFF09"
  - "\u300C\u5E78\u4EBA\u541B\u3082\u3053\u306E\u5BB6\u63A2\u7D22\u3057\u3066\u307F\u3066\u3088!2\u968E\u306B\u4E0A\u304C\u308D\u3046\u3068\u3057\u3066\u3082\u305D\u306E\u5148\u306B\u9032\u3081\u306A\u304B\u3063\u305F\u3093\u3060!\u300D"
  - "\u300C\u305D\u3046\u304B\u2026\u2026\u3002\u300D"
  - "\uFF08\u968E\u6BB5\u3092\u4E0A\u304C\u308C\u306A\u3044\u306A\u3093\u3066\u3053\u3068\u306F\u306A\u3044\u3060\u308D\u2026\u2026\u3002\u304D\u3063\u3068\u932F\u4E71\u3057\u3066\u3044\u308B\u3093\u3060\u308D\u3046\u306A\u3002\uFF09"
