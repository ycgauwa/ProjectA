  messages6:
  - "\u300C\u5E78\u4EBA\u541B!\u4F55\u304B\u60B2\u9CF4\u304C\u805E\u3053\u3048\u305F\u304B\u3089\u6765\u305F\u3051\u3069\u2026\u2026\u3063\u3066\u5927\u4E08\u592B!?\u300D"
  - "\u300C\u6674!\u60AA\u3044\u3051\u3069\u30C9\u30A2\u30CE\u30D6\u3092\u8ABF\u3079\u3066\u884C\u304F\u3046\u3061\u306B\u624B\u304C\u51CD\u308A\u4ED8\u3044\u3066\u96E2\u308C\u306A\u304F\u306A\u3063\u3061\u3083\u3063\u305F\u3093\u3060\u3002\u4F55\u3068\u304B\u3057\u3066\u304A\u6E6F\u3068\u304B\u306E\u6EB6\u304B\u305B\u305D\u3046\u306A\u3082\u306E\u3092\u6301\u3063\u3066\u3053\u308C\u305F\u308A\u3057\u306A\u3044\u304B\uFF1F\u300D"
  - "\u300C\u3046\u3001\u3046\u3093\u3002\u5927\u4E08\u592B\u3060\u3051\u3069\u305D\u308C\u75DB\u304F\u306A\u3044\u306E\uFF1F\u300D"
  - "\u300C\u3042\u3042\u3001\u51CD\u3063\u3066\u304F\u77AC\u9593\u306B\u9A5A\u3044\u3066\u53EB\u3093\u3067\u3057\u307E\u3063\u305F\u3051\u3069\u611F\u899A\u3082\u4F55\u3082\u611F\u3058\u306A\u3044\u304B\u3089\u75DB\u304F\u306F\u306A\u3044\u3093\u3060\u3002\u305F\u3060\u3053\u3053\u304B\u3089\u5168\u304F\u52D5\u3051\u306A\u3044\u306E\u306F\u304B\u306A\u308A\u307E\u305A\u3044\u3002\u300D"
  - "\u300C\u306A\u308B\u307B\u3069\u306D\u3001\u5206\u304B\u3063\u305F\u3088!\u3067\u304D\u308B\u3060\u3051\u6025\u3044\u3067\u6301\u3063\u3066\u304F\u308B\u306D\uFF01\u300D"
  - "\u300C\u3042\u3041\u3001\u983C\u308A\u306B\u3057\u3066\u308B\u305E\u6674!\u304A\u9858\u3044\u3060\u3002\u300D"
