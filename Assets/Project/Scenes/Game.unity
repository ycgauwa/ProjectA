  middleButtonMessages:
  - "\u300C\u4F55\u304B\uFF1F\u4F55\u304B\u3063\u3066\u4F55\uFF1F\u300D"
  - "\uFF08\u6674\u306F\u3042\u306E\u5316\u3051\u7269\u3068\u51FA\u4F1A\u3063\u305F\u3053\u3068\u306F\u306A\u3044\u306E\u304B\u3002\uFF09"
