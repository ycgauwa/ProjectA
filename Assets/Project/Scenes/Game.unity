  messages:
  - "\u300C\u306A\u3093\u3060\u3088\u2026\u2026\u3053\u308C\u3002\u300D"
  - "\u300C\u3053\u3093\u306A\u5927\u5CA9\u3001\u7206\u5F3E\u3067\u3082\u306A\u3044\u9650\u308A\u3069\u3046\u3057\u3088\u3046\u3082\u306A\u3044\u305E\uFF1F\u300D"
  - "\u300C\u3053\u3053\u306E\u5751\u9053\u306F\u4ED6\u306B\u3082\u9053\u304C\u3042\u3063\u305F\u306F\u305A\u3060\u3002\u307E\u305A\u306F\u305D\u3063\u3061\u3092\u8ABF\u3079\u3066\u307F\u306A\u3044\u3068\u2026\u2026\u300D"
  messages2:
  - "\u300C\u3084\u3063\u3068\u3053\u3053\u307E\u3067\u6765\u308C\u305F\u3002\u8272\u3093\u306A\u5316\u3051\u7269\u306B\u8FFD\u308F\u308C\u3066\u304D\u3066\u5927\u5207\u306A\u53CB\u4EBA\u3060\u3063\u3066\u5931\u3063\u305F\u2026\u2026\u3002\u300D"
  - "\u300C\u3044\u3084\u3001\u7121\u4E8B\u306B\u3053\u3053\u304B\u3089\u9003\u3052\u3066\u52A9\u3051\u3092\u547C\u3076\u3093\u3060\u3063!\u300D"
