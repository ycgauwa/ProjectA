  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - "\u5148\u307B\u3069\u306C\u3044\u3050\u308B\u307F\u304C\u4E57\u3063\u3066\u3044\u305F\u30AB\u30FC\u30DA\u30C3\u30C8\u306E\u4E0A\u306B\u5927\u304D\u306A\u8089\u304C\u7F6E\u304B\u308C\u3066\u3044\u308B\u3002"
  - "\u300C\u3053\u308C\u306F\u2026\u2026\u4E00\u4F53\uFF1F\u307E\u3055\u304B\u3042\u306E\u306C\u3044\u3050\u308B\u307F\u304C\u5909\u5316\u3057\u305F\u306E\u304B\u2026\u2026\uFF1F\u300D"
  - "\uFF08\u4F55\u304C\u4F55\u3060\u304B\u5206\u304B\u3089\u306A\u3044\u3051\u3069\u3001\u8FF7\u3063\u3066\u3044\u308B\u6687\u306F\u306A\u3044!\uFF09"
  - "\uFF08\u3053\u3044\u3064\u3092\u3042\u306E\u5316\u3051\u7269\u306B\u898B\u305B\u308C\u3070\u6C17\u3092\u5F15\u3051\u308B\u53EF\u80FD\u6027\u304C\u3042\u308B!\uFF09"
  names:
