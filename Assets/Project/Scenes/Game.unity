  messages:
  - "\u3053\u306E\u306C\u3044\u3050\u308B\u307F\u306F\u4E00\u4F53\u2026\u2026\uFF1F"
  - "\u300C\u4EBA\u9593\u3055\u3093\u3053\u3093\u3070\u3093\u308F\u3002\u307C\u304F\u306F\u3057\u304C\u306A\u3044\u30AD\u30CE\u30B3\u3055\u3002\u300D"
  - "\u300C\uFF01\uFF1F\u3042\u3093\u305F\u306F\u306C\u3044\u3050\u308B\u307F\u3058\u3083\u306A\u3044\u306E\uFF1F\u558B\u308C\u308B\u306A\u3093\u3066\u3059\u3054\u3044\u306D\u3001\u3001\u300D"
  - "\uFF08\u3053\u3093\u306A\u751F\u304D\u7269\u306E\u3088\u3046\u306A\u4E0D\u601D\u8B70\u306A\u5B58\u5728\u304C\u3044\u308B\u306A\u3093\u3066\u4FE1\u3058\u3089\u308C\u306A\u3044\u305E\u3001\u3001\u3053\u306E\u5BB6\u306F\u672C\u5F53\u306B\u3069\u3046\u306A\u3063\u3066\u3044\u308B\u3093\u3060\uFF1F\uFF09"
  - "\u300C\u50D5\u306D\u3001\u8D64\u8272\u304C\u597D\u304D\u306A\u3093\u3060\u3002\u306A\u3093\u3067\u304B\u3063\u3066\u3044\u3046\u3068\u50D5\u306F\u98DF\u3079\u305F\u98DF\u6750\u306E\u8272\u306B\u306A\u308C\u308B\u3093\u3060\u3051\u3069\u3055\u3001\u8D64\u8272\u306E\u98DF\u3079\u7269\u3092\u3082\u3063\u3068\u305F\u304F\u3055\u3093\u98DF\u3079\u305F\u3044\u3093\u3060\uFF01\u300D"
  - "\u300C\u8D64\u3044\u3082\u306E\u3092\u305F\u304F\u3055\u3093\u98DF\u3079\u308B\u3068\u306D\u3001\u307C\u304F\u3082\u3063\u3068\u3082\u3063\u3068\u4F53\u304C\u8D64\u304F\u306A\u308B\u3093\u3060\uFF01\u30AD\u30CE\u30B3\u306E\u4E16\u754C\u3067\u306F\u4F53\u304C\u8D64\u3044\u3084\u3064\u304C\u51C4\u3044\u3093\u3060\u305E\uFF01\u300D"
  - "\uFF08\u30AD\u30CE\u30B3\u306E\u6587\u5316\u3084\u4FA1\u5024\u89B3\u72EC\u7279\u3059\u304E\u306A\u3044\u304B\u2026\u2026\uFF1F\uFF09"
