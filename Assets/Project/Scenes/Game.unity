  seimessages:
  - "\u300C\u3084\u3063\u3068\u3001\u3053\u306E\u672C\u68DA\u3092\u8ABF\u3079\u308B\u3053\u3068\u304C\u51FA\u6765\u308B\u306A\u3002\u300D"
  - "\u300C\u78BA\u304B\u3001\u5DE6\u306E\u65B9\u306B\u5165\u308C\u3066\u304A\u3044\u305F\u672C\u304C\u3042\u3063\u305F\u306F\u305A\u3060\u304C\u2026\u2026\u3002\u300D"
  - "\u300C\u304A\u3063\u3001\u3053\u308C\u304B\u3002\u6539\u3081\u3066\u76EE\u3092\u901A\u3057\u3066\u304A\u304F\u304B\u3002\u300D"
  - "\uFF08\u2026\u2026\uFF1F\u6700\u5F8C\u306E\u65B9\u3060\u3051\u6587\u5B57\u304C\u3050\u3061\u3083\u3050\u3061\u3083\u3067\u8AAD\u3081\u306A\u304F\u306A\u3063\u3066\u3044\u308B\u2026\u2026\uFF09"
