  messages4:
  - "\u300C\u3053\u306E\u9332\u97F3\u3092\u8AB0\u304C\u805E\u3044\u3066\u3044\u308B\u304B\u306F\u5206\u304B\u3089\u306A\u3044\u304C\u3001\u5316\u3051\u7269\u306B\u3064\u3044\u3066\u306E\u8A18\u9332\u3092\u6B8B\u305D\u3046\u3068\u601D\u3046\u3002\u300D"
  - "\u300C\u5974\u3089\u306F\u3010\u5B9F\u9A13\u4F53\u3011\u3068\u547C\u3070\u308C\u308B\u5316\u3051\u7269\u3069\u3082\u3060\u304C\u3001\u305D\u306E\u6B63\u4F53\u306F\u3053\u306E\u6C11\u5BB6\u306E\u5916\u306B\u3042\u308B\u904E\u9177\u3059\u304E\u308B\u74B0\u5883\u306B\u9069\u5FDC\u3059\u308B\u305F\u3081\u306B\u5B9F\u9A13\u306B\u3088\u3063\u3066\u751F\u307E\u308C\u305F\u751F\u304D\u7269\u3060\u3002\u300D"
  - "\u300C\u8A73\u3057\u3044\u4E8B\u306F\u4FFA\u306B\u3082\u5206\u304B\u3089\u3093\u304C\u3001\u5974\u3089\u3092\u5012\u305B\u308B\u3068\u8003\u3048\u306A\u3044\u65B9\u304C\u826F\u3044\u3002\u5143\u3005\u306F\u751F\u7269\u5175\u5668\u3068\u3057\u3066\u7814\u7A76\u3055\u308C\u3066\u3044\u305F\u3088\u3046\u306A\u751F\u7269\u3060\u3002\u305F\u3060\u306E\u4EBA\u9593\u304C\u6BBA\u305B\u308B\u3088\u3046\u306A\u3082\u306E\u3067\u3082\u306A\u3044\u3060\u308D\u3046\u3002\u300D"
  - "\u300C\u305D\u3093\u306A\u3084\u3064\u3089\u3067\u3082\u3001\u3082\u3057\u304B\u3057\u305F\u3089\u5F31\u70B9\u306B\u306A\u308A\u3048\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u70B9\u304C\u5206\u304B\u3063\u305F\u3002\u3053\u308C\u3092\u805E\u3044\u3066\u3044\u308B\u4EBA\u306B\u306F\u4FFA\u306E\u898B\u89E3\u3092\u4F1D\u3048\u305F\u3044\u3068\u601D\u3046\u3002\u300D"
  - "\u300C\u5974\u3089\u306F\u4EE5\u4E0A\u306B\u51B7\u6C17\u306B\u8010\u6027\u3092\u6301\u3063\u3066\u3044\u308B\u3001\u51B7\u51CD\u5EAB\u3069\u3053\u308D\u304B\u5357\u6975\u3067\u3082\u5143\u6C17\u306B\u6D3B\u52D5\u3067\u304D\u308B\u3060\u308D\u3046\u3002\u300D"
  - "\u300C\u3057\u304B\u3057\u3001\u51B7\u6C17\u306B\u8010\u6027\u304C\u3042\u308A\u3059\u304E\u308B\u5206\u71B1\u306B\u5F31\u3044\u306E\u3067\u306F\u306A\u3044\u304B\u3068\u8003\u3048\u3066\u3044\u308B\u3002\u5927\u304D\u306A\u708E\u3067\u3082\u51FA\u3057\u305F\u3089\u5ACC\u304C\u308A\u306F\u3059\u308B\u3093\u3058\u3083\u306A\u3044\u3060\u308D\u3046\u304B\uFF1F\u300D"
  - "\u300C\u307E\u3041\u305D\u3093\u306A\u708E\u3092\u51FA\u3059\u5834\u5408\u306F\u6C11\u5BB6\u304C\u5168\u713C\u3057\u3066\u3053\u308C\u3092\u805E\u3044\u3066\u308B\u4EBA\u3082\u305F\u3060\u3058\u3083\u3059\u307E\u306A\u3044\u3068\u601D\u3046\u3051\u3069\u306A\u3002\u300D"
  - "\u300C\u3010\u5B9F\u9A13\u4F53\u3011\u306F\u5B9F\u9A13\u306B\u3088\u3063\u3066\u751F\u307E\u308C\u305F\u4EE5\u4E0A\u306B\u51B7\u6C17\u306E\u8010\u6027\u306E\u3042\u308B\u3001\u5316\u3051\u7269\u3069\u3082\u3060\u3002\u5927\u304D\u306A\u708E\u3067\u5ACC\u304C\u3089\u305B\u7A0B\u5EA6\u306F\u51FA\u6765\u308B\u304B\u3082\u306A\u3002\u300D"
  - "\u300C\u4FFA\u304C\u5F97\u305F\u60C5\u5831\u306F\u3053\u3093\u306A\u3082\u3093\u3060\u3002\u304A\u4E92\u3044\u3001\u751F\u304D\u3066\u4F1A\u3048\u305F\u3089\u826F\u3044\u306A\u2026\u2026\u3002\u300D"
