  messages:
  - "\u5B9D\u7BB1\u306E\u5F62\u3092\u3057\u305F\u53CE\u7D0D\u30B1\u30FC\u30B9\u306E\u3088\u3046\u3060\u3002\u4E2D\u3092\u8997\u304F\u3068\u5927\u304D\u306A\u30B1\u30FC\u30B9\u3068\u5468\u308A\u306B\u914D\u7DDA\u304C\u7D61\u3093\u3067\u3044\u308B\u3002"
  - "\u300C\u2026\u2026\u3048\u3001\u3053\u308C\u3063\u3066\u307E\u3055\u304B\u7206\u5F3E!?\u300D"
  - "\u5B9D\u7BB1\u3092\u958B\u3051\u305F\u305F\u3081\u304B\u305D\u308C\u307E\u3067\u805E\u3053\u3048\u306A\u304B\u3063\u305F\u96FB\u5B50\u97F3\u304C\u4E00\u5B9A\u306E\u30EA\u30BA\u30E0\u3067\u97F3\u3092\u9CF4\u3089\u3057\u3066\u3044\u308B\u3002"
  - "\uFF08\u5653\u3060\u308D\u2026\u2026\u3002\u3088\u304F\u898B\u308B\u3068\u30BF\u30A4\u30DE\u30FC\u307F\u305F\u3044\u306A\u8868\u8A18\u3082\u3069\u3093\u3069\u3093\u6570\u5B57\u304C\u5C0F\u3055\u304F\u306A\u3063\u3066\u3044\u308B\u3057\u3001\u89E3\u9664\u3057\u306A\u3044\u3068\u3068\u3093\u3067\u3082\u306A\u3044\u3053\u3068\u306B\u306A\u308A\u305D\u3046\u3060\u3002\uFF09"
  - "\u300C\u7D76\u5BFE\u4F55\u3068\u304B\u3057\u306A\u3044\u3068!\u3053\u306E\u307E\u307E\u3058\u3083\u7206\u767A\u3057\u3066\u3057\u307E\u3046!\u300D"
