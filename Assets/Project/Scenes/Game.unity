  messages:
  - "\uFF08\u6559\u5E2B\u304C\u66F8\u3044\u305F\u65E5\u8A18\u304C\u6B8B\u3055\u308C\u3066\u3044\u308B\u3002\uFF09"
  - "\u300C\u3042\u308C\uFF1F\u7406\u79D1\u5BA4\u306B\u3053\u3093\u306A\u306E\u7F6E\u3044\u3066\u3042\u3063\u305F\u3063\u3051\uFF1F\u2026\u2026\u307E\u3041\u8AAD\u3093\u3067\u307F\u308B\u304B\u3002\u300D"
  names:
  - 
  - "\u5E78\u4EBA"
  image:
  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  seimessages: []
  seinames: []
  seiimages: []
  sentences:
  - "\u307E\u305F\u3060\u3002\u307E\u305F\u3001\u751F\u5F92\u305F\u3061\u304C\u90FD\u5E02\u4F1D\u8AAC\u3060\u306E\u9A12\u304E\u59CB\u3081\u3066\u3053\u3061\u3089\u3068\u3057\u3066\u306F\u305F\u307E\u3063\u305F\u3082\u3093\u3058\u3083\u306A\u3044\u3002\u6DF1\u591C\u306B\u898B\u56DE\u308A\u3059\u308B\u8B66\u5099\u54E1\u306E\u4EBA\u3082\u82E6\u52B4\u3057\u3066\u3044\u308B\u3001\u307F\u305F\u3044\u3060\u3057\u4ECA\u5EA6\u671D\u4F1A\u3067\u6CE8\u610F\u3057\u3066\u3082\u3089\u304A\u3046\u304B\u3002"
  - "\u6628\u65E5\u304B\u3089\u8B66\u5099\u54E1\u306E\u69D8\u5B50\u304C\u304A\u304B\u3057\u3044\u3002\u660E\u3089\u304B\u306B\u305D\u308F\u305D\u308F\u3057\u3066\u3044\u308B\u3057\u3001\u5225\u306E\u5148\u751F\u304C\u4E8B\u60C5\u3092\u805E\u3044\u3066\u307F\u308B\u3068\u3001\u6DF1\u591C\u306B\u5B66\u6821\u306B\u4FB5\u5165\u3057\u305F\u751F\u5F92\u305F\u3061\u304C\u3044\u305F\u3089\u3057\u3044\u3002"
