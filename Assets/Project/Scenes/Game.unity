  messages3:
  - "\u300C\u3053\u306E\u4E16\u754C\u306E\u6C11\u5BB6\u306E\u30C9\u30A2\u306B\u89E6\u308C\u308B\u306A\u3093\u3066\u30D0\u30AB\u306E\u3084\u308B\u3053\u3068\u3060\u3002\u300D"
  - "\u300C\u305D\u308C\u304B\u3001\u5916\u306E\u4E16\u754C\u304C\u3069\u3046\u306A\u3063\u3066\u308B\u304B\u77E5\u3089\u306A\u3044\u7121\u77E5\u306A\u5974\u3089\u3060\u3051\u3060\u306A\u3002\u300D"
