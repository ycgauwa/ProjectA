  hidingMessages:
  - "\u300C\u307E\u3060\u3001\u5916\u306B\u6C17\u914D\u304C\u3059\u308B\u3002\u9003\u3052\u5207\u308C\u306A\u304B\u3063\u305F\u306E\u304B\uFF1F\u300D"
  - "\uFF08\u3053\u306E\u307E\u307E\u3044\u308C\u3070\u3001\u9178\u6B20\u306A\u3069\u3067\u4E0D\u5177\u5408\u3092\u62B1\u3048\u308B\u3053\u3068\u306B\u306A\u308B\u3060\u308D\u3046\u3001\u3067\u3082\u3053\u306E\u307E\u307E\u5916\u306B\u51FA\u308C\u3070\u78BA\u5B9F\u306B\u6BBA\u3055\u308C\u308B\u2026\u2026\uFF01\uFF09"
