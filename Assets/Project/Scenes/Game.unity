  mushroomfailmessages:
  - "\u300C\u3053\u308C\u3068\u3063\u3066\u3082\u304A\u3044\u3057\u305D\u3046\u3060\u306D!\u65E9\u901F\u3060\u3051\u3069\u98DF\u3079\u3061\u3083\u3046\u3088!\u300D"
  - "\u304D\u306E\u3053\u306E\u306C\u3044\u3050\u308B\u307F\u306F\u3069\u3046\u3084\u3063\u3066\u304B\u98DF\u7269\u3092\u53E3\u306B\u904B\u3073\u9759\u304B\u306B\u5480\u56BC\u3057\u3066\u3044\u308B\u3002\u3057\u304B\u3057\u6BB5\u3005\u3068\u7709\u304C\u3072\u305D\u3081\u3089\u308C\u3066\u3044\u304F\u3002"
  - "\u300C\u2026\u2026\u2026\u2026\u2026\u2026\u3052\u3047\u300D"
  - "\u306C\u3044\u3050\u308B\u307F\u306E\u524D\u306B\u3050\u3061\u3083\u3050\u3061\u3083\u306B\u306A\u3063\u305F\u6599\u7406\u306E\u6B8B\u9AB8\u304C\u5410\u304D\u51FA\u3055\u308C\u305F\u3002"
  - "\u300C\u305D\u3063\u304B\u3002\u4F5C\u3063\u3066\u304D\u3066\u304F\u308C\u305F\u4EBA\u9593\u3055\u3093\u306B\u306F\u7533\u3057\u8A33\u306A\u3044\u3093\u3060\u3051\u3069\u3001\u50D5\u306E\u53E3\u306B\u5408\u308F\u306A\u304B\u3063\u305F\u307F\u305F\u3044\u3002\u300D"
  - "\u300C\u3044\u3084\u3001\u307E\u3055\u304B\u5410\u304D\u51FA\u3059\u307B\u3069\u307E\u305A\u3044\u3082\u306E\u3092\u4F5C\u3063\u3066\u3057\u307E\u3063\u305F\u4FFA\u306B\u3082\u8CAC\u4EFB\u306F\u3042\u308B\u3068\u601D\u3046\u3002\u3059\u307E\u306A\u3044\u3002\u300D"
  - "\u300C\u3048\uFF1F\u4EBA\u9593\u3055\u3093\u304C\u8CAC\u4EFB\u3092\u611F\u3058\u308B\u5FC5\u8981\u306F\u306A\u3044\u3088!\u3060\u3063\u3066\u50D5\u304C\u304A\u9858\u3044\u3057\u305F\u308F\u3051\u3060\u3057\u3055\u300D"
  - "\u300C\u305D\u3046\u304B\uFF1F\u305D\u308C\u3067\u3082\u76EE\u306E\u524D\u3067\u82E6\u3057\u305D\u3046\u306B\u3057\u3066\u3044\u305F\u3089\u5C11\u3057\u7533\u3057\u8A33\u306A\u304F\u306A\u3063\u3061\u3083\u3046\u306A\u300D"
  - "\u300C\u306A\u308B\u307B\u3069\u306D\u2026\u2026\u3002\u4EBA\u9593\u3055\u3093\u306F\u3044\u3044\u4EBA\u9593\u3055\u3093\u306A\u3093\u3060\u306D!\u305D\u3093\u306A\u4EBA\u9593\u3055\u3093\u306B\uFF11\u3064\u304A\u9858\u3044\u304C\u3042\u308B\u3093\u3060!\u300D"
  - "\u300C\u3093\uFF1F\u3069\u3046\u3057\u305F\uFF1F\u6599\u7406\u306F\u96E3\u3057\u3044\u304B\u3082\u3057r\u3066\u306A\u3044\u304C\u3061\u3087\u3063\u3068\u3057\u305F\u3053\u3068\u306A\u3089\u529B\u306B\u306A\u308C\u308B\u305E\u3002\u300D"
  - "\u300C\u307C\u304F\u3001\u8D64\u3044\u3082\u306E\u3092\u98DF\u3079\u308B\u3068\u4F53\u304C\u8D64\u304F\u306A\u308B\u3093\u3060\u3051\u3069\u3001\u305D\u308C\u3063\u3066\u6DB2\u4F53\u3067\u3082\u3044\u3044\u3093\u3060!\u3064\u307E\u308A\u4EBA\u9593\u3055\u3093\u306E\u8840\u3092\u3061\u3087\u3063\u3068\u5206\u3051\u3066\u307B\u3057\u3044\u306E!\u300D"
  - "\u300C\u8840\u3092\uFF1F\u2026\u2026\u307E\u3041\u3061\u3087\u3063\u3068\u3060\u3051\u306A\u3089\u3002\u300D"
