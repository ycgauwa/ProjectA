  messages:
  - "\u53D7\u8A71\u5668\u304C\u7F6E\u304B\u308C\u3066\u3044\u308B\u3002"
  - "\u300C\u2026\u2026\u56FA\u5B9A\u96FB\u8A71\u304B\u3002\u6700\u8FD1\u898B\u306A\u3044\u304B\u3089\u73CD\u3057\u304F\u611F\u3058\u3061\u3083\u3046\u306A\u3002\u300D"
  - "\u300C\u9332\u97F3\u6A5F\u80FD\u3082\u3042\u308B\u304C\u3001\u4F55\u304B\u60C5\u5831\u304C\u6B8B\u3063\u3066\u3044\u306A\u3044\u304B\u78BA\u304B\u3081\u3066\u307F\u308B\u304B\u3002\u300D"
  names:
  - "\u5E78\u4EBA"
  - "\u5E78\u4EBA"
  - "\u5E78\u4EBA"
  images:
