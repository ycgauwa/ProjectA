  m_Script: {fileID: 11500000, guid: b38754f425bac5b4495a6f680c118485, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - "\uFF08\u4F55\u3060\u304B\u3088\u304F\u308F\u304B\u3089\u306A\u3044\u672C\u304C\u305F\u304F\u3055\u3093\u4E26\u3093\u3067\u3044\u308B\u3002\u8AAD\u3093\u3067\u307F\u3066\u3082\u5185\u5BB9\u306F\u5206\u304B\u3089\u306A\u3055\u305D\u3046\u3060\u306A\u3002\uFF09"
  - "\u3075\u3068\u4E0A\u624B\u304F\u3057\u307E\u308F\u308C\u3066\u3044\u306A\u3044\u8584\u3044\u518A\u5B50\u3092\u898B\u3064\u3051\u305F\u3002"
  - "\u300C\u3042\u308C\u2026\u2026\u3053\u308C\u3082\u3057\u304B\u3057\u3066\u65E5\u8A18\uFF1F\u2026\u2026\u3044\u3084\u624B\u5E33\u3060\u306A\u3002\u300D"
  - "\uFF08\u3057\u304B\u3082\u3053\u306E\u30C7\u30B6\u30A4\u30F3\u4F55\u3060\u304B\u672C\u5C4B\u3067\u898B\u305F\u3053\u3068\u304C\u3042\u308B\u306A\u3002\u3082\u3057\u304B\u3057\u3066\u4FFA\u3068\u540C\u3058\u3088\u3046\u306B\u9023\u308C\u3066\u3053\u3089\u308C\u305F\u4EBA\u306E\u7269\u304B\uFF1F\uFF09"
  - "\u300C\u306A\u306B\u304B\u624B\u304C\u304B\u308A\u304C\u5206\u304B\u308B\u304B\u3082\u3057\u308C\u306A\u3044\u3002\u5C11\u3057\u8AAD\u3093\u3067\u898B\u308B\u304B\u3002\u300D"
  names:
  - "\u5E78\u4EBA"
  - "\u5E78\u4EBA"
  - "\u5E78\u4EBA"
  - "\u5E78\u4EBA"
  - "\u5E78\u4EBA"
  image:
  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  - {fileID: 21300000, guid: 846f20be52de4934381c6c80cbacbaee, type: 3}
  seimessages:
  - "\u300C\u3093\uFF1F\u3053\u3063\u3061\u306E\u672C\u68DA\u306B\u3082\u660E\u3089\u304B\u306B\u96F0\u56F2\u6C17\u306E\u9055\u3046\u3082\u3093\u304C\u6DF7\u3058\u3063\u3066\u3084\u304C\u308B\u3002\u300D"
  - "\u300C\u2026\u2026\u3084\u3063\u3071\u308A\u3053\u308C\u3082\u65E5\u8A18\u304B\u3002\u4F55\u304B\u306B\u5F79\u7ACB\u3064\u306F\u305A\u3060\u308D\u3046\u3057\u8AAD\u3093\u3067\u304A\u304F\u304B\u3002\u300D"
  seinames:
  - 
  - 
  seiimages:
  - {fileID: 0}
  - {fileID: 0}
  sentences:
  - "\u308F\u305F\u3057\u3001\u306A\u3093\u3067\u3053\u3093\u306A\u306B\u751F\u304D\u305F\u3044\u3093\u3060\u308D\u3046\u3002\u3053\u306E\u5371\u967A\u306A\u6751\u3067\u6E80\u8DB3\u306B\u751F\u304D\u3066\u3044\u304F\u305F\u3081\u306B\u306F\u547D\u306E1\u3064\u30842\u3064\u3058\u3083\u8DB3\u308A\u306A\u3044\u3002"
  - "\u6587\u5B57\u901A\u308A\u79C1\u306F\u4F55\u500B\u3082\u4F55\u5341\u3082\u306E\u547D\u3092\u4F7F\u3063\u3066\u4F55\u3068\u304B\u751F\u304D\u5EF6\u3073\u3066\u308B\u3002\u3067\u3082\u305D\u3093\u306A\u751F\u6D3B\u3082\u3064\u304B\u308C\u3066\u304D\u3061\u3083\u3063\u305F\u3002"
  - "\u8FD1\u5BC4\u3063\u3066\u4EF2\u826F\u304F\u306A\u3063\u3066\u88CF\u5207\u3063\u3066\u9A19\u3057\u3066\u3001\u6642\u306B\u306F\u5618\u3092\u3064\u3044\u3066\u990C\u306B\u3057\u3066\u3002\u7537\u306E\u4EBA\u3092\u8A98\u60D1\u3057\u3066\u56EE\u306B\u3055\u305B\u305F\u3053\u3068\u3082\u3042\u3063\u305F\u6C17\u304C\u3059\u308B\u3002"
  - "\u305D\u3093\u306A\u751F\u6D3B\u3092\u3069\u308C\u3060\u3051\u7D9A\u3051\u3066\u3082\u3042\u306E\u602A\u7269\u305F\u3061\u306F\u79C1\u306E\u76EE\u306E\u524D\u306B\u7D76\u5BFE\u73FE\u308C\u308B\u3002\u3080\u3057\u308D\u6700\u521D\u306E\u6642\u3088\u308A\u3082\u983B\u5EA6\u304C\u3069\u3093\u3069\u3093\u4E0A\u304C\u3063\u3066\u3044\u3066\u308B\u3002"
  - "\u3082\u3057\u304B\u3057\u305F\u3089\u3001\u79C1\u306B\u5BFE\u3057\u3066\u306E\u6068\u307F\u304C\u3042\u306E\u602A\u7269\u306B\u529B\u3092\u4E0E\u3048\u3066\u3044\u308B\u306E\u304B\u306A\uFF1F\u305D\u308C\u306A\u3089\u76AE\u8089\u306A\u8A71\u3060\u3088\u306D\u3001\u751F\u304D\u305F\u3044\u3063\u3066\u601D\u3063\u3066\u3082\u5F90\u3005\u306B\u9053\u304C\u72ED\u304F\u306A\u308B\u3002"
  - "\u6B21\u3001\u602A\u7269\u306B\u4F1A\u3063\u305F\u3089\u3082\u3046\u9003\u3052\u308B\u3053\u3068\u306F\u8AE6\u3081\u3088\u3046\u3002\u751F\u304D\u305F\u307E\u307E\u98DF\u3079\u3089\u308C\u308B\u3060\u308D\u3046\u3057\u3068\u3066\u3082\u75DB\u3044\u3068\u601D\u3046\u3051\u3069\u5730\u7344\u306B\u884C\u304F\u524D\u6E96\u5099\u3068\u3057\u3066\u306F\u3053\u308C\u304F\u3089\u3044\u304C\u597D\u307E\u3057\u3044\u3088\u306D\u3002"
