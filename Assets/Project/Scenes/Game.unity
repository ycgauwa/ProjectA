  mushroomfailedMetamessages:
  - "\u300C\u3048\u2026\u2026\u4EBA\u9593\u3055\u3093\u2026\u2026\u3055\u3059\u304C\u306B\u5197\u8AC7\u3067\u3057\u3087?\u300D"
  - "\u300C\u3042\u3093\u306A\u76EE\u306B\u3042\u3063\u305F\u3068\u3044\u3046\u306E\u306B\u61F2\u308A\u306A\u3044\u3068\u3044\u3046\u304B\u306A\u3093\u3068\u3044\u3046\u304B\u2026\u2026\u3002\u300D"
  - "\u300C\u3042\u3063!\u3082\u3057\u304B\u3057\u3066\u5B8C\u5168\u306B\u899A\u3048\u3066\u306A\u3044\u306E\u304B\u306A?\u3044\u3084\u3001\u6D41\u77F3\u306B\u305D\u3093\u306A\u3053\u3068\u306F\u306A\u3044\u306F\u305A\u2026\u2026?\u300D"
  - "\u300C?\u3055\u3063\u304D\u304B\u3089\u4F55\u306E\u8A71\u3092\u3057\u3066\u308B\u3093\u3060?\u300D"
  - "\u300C\u4ECA\u306E\u4EBA\u9593\u3055\u3093\u306B\u306F\u95A2\u4FC2\u306E\u306A\u3044\u3053\u3068\u3060\u3088\u3002\u5927\u4E08\u592B\u50D5\u305F\u3061\u306F\u512A\u3057\u3044\u304B\u30892\u56DE\u3082\u9177\u3044\u3053\u3068\u306F\u3057\u306A\u3044\u3088\u3002\u300D"
  - "\u300C2\u5EA6\u3042\u308B\u3053\u3068\u306F3\u5EA6\u3042\u308B\u3063\u3066\u3044\u3046\u3057\u50D5\u305F\u3061\u3082\u3044\u3061\u3044\u3061\u304A\u4ED5\u7F6E\u304D\u3057\u3066\u305F\u3089\u75B2\u308C\u3061\u3083\u3046\u3082\u3093\u306D\u3002\u300D"
  - "\u300C\u672C\u5F53\u306B\u4F55\u3092\u8A00\u3063\u3066\u3044\u308B\u304B\u308F\u304B\u3089\u306A\u3044\u3093\u3060\u3051\u3069\u2026\u2026?\u4E00\u4F53\u3069\u3046\u3044\u3046\u4E8B?\u300D"
  - "\u300C\u4ECA\u89E3\u8AAC\u3057\u3066\u3082\u7121\u99C4\u3060\u3068\u601D\u3046\u304B\u3089\u4F55\u3082\u8A00\u308F\u306A\u3044\u3088\u3002\u3053\u306E\u6751\u3067\u305F\u304F\u3055\u3093\u306E\u8F2A\u5EFB\u3092\u56DE\u308B\u3068\u305D\u306E\u5185\u6C17\u3065\u304F\u3093\u3058\u3083\u306A\u3044?\u307E\u3041\u305D\u306E\u6642\u306B\u4EBA\u9593\u3055\u3093\u304C\u4EBA\u9593\u306E\u307E\u307E\u3067\u3044\u3089\u308C\u308B\u304B\u306F\u77E5\u3089\u306A\u3044\u3051\u3069\u306D\u2026\u2026\u3002\u300D"
  - "\u300C\u3064\u307E\u3089\u306A\u3044\u8A71\u3067\u6642\u9593\u3092\u53D6\u3063\u3066\u3057\u307E\u3063\u305F\u306D\u3002\u3044\u3044\u3088!\u4ECA\u56DE\u306F\u6599\u7406\u3092\u8CB0\u3063\u305F\u3053\u3068\u306B\u3057\u3066\u3042\u3052\u308B\u306D\u300D"
