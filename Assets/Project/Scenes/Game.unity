  - "2\u4EBA\u3067\u751F\u304D\u6B8B\u308B\u305F\u3081\u306E\u65B9\u6CD5\u304C\u306A\u3044\u304B\u2026\u2026\u306A\u306B\u304B\u3042\u308B\u306F\u305A\u3060\u3001\u3068\u8003\u3048\u3066\u3044\u305F\u6700\u4E2D\u306B\u6674\u304B\u3089\u58F0\u304C\u304B\u304B\u308B\u3002"
  - "\u300C\u306F\u3041\u2026\u2026\u306F\u3041\u2026\u2026\u3002\u3082\u3046\u9650\u754C\u3060\u3002\u50D5\u306E\u3053\u3068\u306F\u2026\u2026\u7F6E\u3044\u3066\u884C\u3063\u3066\u307B\u3057\u3044\u2026\u2026\u3002\u300D"
  - "\u300C\u3042\uFF1F\u4F55\u8A00\u3063\u3066\u3093\u3060\u3088!!\u3075\u3056\u3051\u3093\u306A!!!2\u4EBA\u3067\u751F\u304D\u6B8B\u308B\u3093\u3060\u3088!!\u300D"
