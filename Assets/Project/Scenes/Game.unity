--- !u!114 &1556150082
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1556150078}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 909938ad274a04343bbe412683133a11, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  messages:
  - "\u4F55\u304B\u3067\u62BC\u3055\u3048\u3064\u3051\u3089\u308C\u3066\u3044\u308B\u306E\u304B\u3001\u30C9\u30A2\u306F\u3073\u304F\u3068\u3082\u52D5\u304B\u306A\u3044\u3088\u3046\u3060"
  - "\u300C\u3061\u3063\u3001\u9375\u304C\u304B\u304B\u3063\u3066\u3044\u308B\u308F\u3051\u3067\u3082\u306D\u3048\u306E\u306B\u958B\u304B\u306D\u3048\u306E\u304B\u3002\u300D"
  - "\u300C\u3057\u3087\u3046\u304C\u306D\u3048\u306A\u3002\u4E00\u5EA6\u5225\u306E\u90E8\u5C4B\u306E\u65B9\u306B\u884C\u3063\u3066\u307F\u308B\u304B\u3002\u300D"
  messages2:
  - "\uFF08\u8AB0\u304B\u3044\u308B\u2026\u2026\u307E\u3055\u304B\u2026\u2026\uFF1F\uFF09"
  - "\u300C\u304A\u3044\uFF01\u5927\u4E08\u592B\u304B\uFF01\uFF1F\u3082\u3057\u304B\u3057\u3066\u6674\u541B\u304B\uFF1F\u300D"
  - "\u300C\u4F55\u304B\u8FD4\u4E8B\u3092\u3057\u3066\u304F\u308C\uFF01\u7121\u4E8B\u306A\u306E\u304B\uFF01\uFF1F\u300D"
  - "\u2026\u2026"
  - "\u300C\u304F\u305D\u3001\u8FD4\u4E8B\u306A\u3057\u304B\u3002\u3069\u3061\u3089\u306B\u305B\u3088\u5B50\u306E\u30C9\u30A2\u3092\u958B\u3051\u308B\u5FC5\u8981\u304C\u51FA\u3066\u304D\u305F\u306A\u3002\u300D"
  - "\u300C\u4F55\u304B\u3067\u9632\u304C\u308C\u3066\u3044\u308B\u307F\u305F\u3044\u3060\u3057\u3001\u56FA\u3044\u677F\u306E\u3088\u3046\u306A\u7269\u304C\u3042\u308C\u3070\u3053\u3058\u958B\u3051\u3089\u308C\u308B\u3093\u3060\u304C\u306A\u2026\u2026\u3002\u300D"
  messages3:
  - "\u76F8\u5909\u308F\u3089\u305A\u6249\u306F\u91CD\u304F\u9589\u3056\u3055\u308C\u305F\u69D8\u5B50\u3060"
  - "\u300C\u3055\u3066\u3001\u6301\u3063\u3066\u304D\u305F\u677F\u3067\u9699\u9593\u3092\u4F5C\u3063\u3066\u3053\u3058\u958B\u3051\u308C\u3070\u5927\u4E08\u592B\u305D\u3046\u3060\u306A\u3002\u300D"
  - "\u300C\u30D5\u30C3\uFF01\u2026\u2026\u300D"
  - "\u5F81\u4E00\u90CE\u304C\u5168\u4F53\u91CD\u3092\u304B\u3051\u3066\u62BC\u3057\u8FBC\u3080\u3068\u6249\u306F\u91CD\u3005\u3057\u304F\u52D5\u304D\u59CB\u3081\u308B"
  - "\u300C\u9699\u9593\u304C\u51FA\u6765\u305F\u304B\u3089\u3001\u5F8C\u306F\u3053\u308C\u3067\u2026\u2026\u3063\uFF01\u300D"
  - "\u308F\u305A\u304B\u306B\u3067\u304D\u305F\u9699\u9593\u306B\u91D1\u5C5E\u677F\u3092\u5DEE\u3057\u8FBC\u307F\u30C6\u30B3\u306E\u539F\u7406\u3067\u5F37\u5F15\u306B\u6249\u304C\u958B\u304B\u308C\u3066\u3044\u304F"
  messages4:
  - "\uFF08\u306A\u3093\u3060\u3053\u308C\u2026\u2026\u3002\u771F\u3063\u6697\u3058\u3083\u306D\u3048\u304B\u3002\uFF09"
  - "\u300C\u304A\u3044\u2026\u2026\u8AB0\u304B\u3044\u308B\u306E\u304B\u30FC\uFF1F\u5927\u4E08\u592B\u304B\uFF1F\u300D"
  - "\u300C\u96FB\u6C17\u3064\u3051\u308B\u305E\uFF1F\u300D"
  messages5:
  - "\u300C\u3084\u3063\u3071\u308A\u541B\u304B\u2026\u2026\u753A\u7FBD\u6674\u541B\u3002\u300D"
  - "\uFF08\u5C11\u3057\u3042\u3069\u3051\u306A\u3055\u3092\u6B8B\u3057\u305F\u3053\u306E\u9752\u5E74\u306F\u753A\u7FBD\u6674\u3068\u3044\u3046\u540D\u524D\u3089\u3057\u3044\u3002\u4FFA\u304C\u3053\u306E\u6C11\u5BB6\u3092\u62E0\u70B9\u306B\u3057\u3066\u3044\u308B\u9593\u306B\u51FA\u4F1A\u3063\u305F\u9752\u5E74\u3060\u3002\uFF09"
  - "\uFF08\u3053\u306E\u304A\u304B\u3057\u306A\u4E16\u754C\u3067\u76EE\u899A\u3081\u3066\u304B\u3089\u51FA\u4F1A\u3063\u305F3\u4EBA\u76EE\u306E\u4EBA\u9593\u3068\u306A\u308B\u3002\u3061\u306A\u307F\u306B1\u4EBA\u76EE\u306F\u5F97\u4F53\u306E\u77E5\u308C\u306A\u3044\u9280\u9AEA\u306E\u5C11\u5973\u30672\u4EBA\u76EE\u306F\u65E2\u306B\u606F\u7D76\u3048\u3066\u3044\u305F\u521D\u8001\u306E\u7537\u6027\u3067\u3042\u3063\u305F\u3002\uFF09"
  - "\uFF08\u3053\u306E\u9752\u5E74\u306F\u4EBA\u61D0\u3063\u3053\u304F\u4E0D\u601D\u8B70\u3068\u666E\u6BB5\u304B\u3089\u5F37\u3044\u4FFA\u306E\u8B66\u6212\u5FC3\u3082\u3053\u306E\u5B50\u306E\u524D\u3067\u306F\u8584\u308C\u3066\u3044\u304F\u3002\u305D\u308C\u3067\u3082\u3044\u3056\u3068\u3044\u3046\u6642\u306B\u8EAB\u4EE3\u308F\u308A\u306B\u3067\u304D\u308B\u4EBA\u6750\u3068\u3057\u3066\u51FA\u6765\u308B\u3060\u3051\u30D5\u30E9\u30F3\u30AF\u306B\u63A5\u3057\u3066\u3044\u308B\u3002\uFF09"
  - "\u300C\u2026\u2026?\u3082\u3057\u304B\u3057\u3066\u2026\u2026\u304A\u3058\u3055\u3093?\u623B\u3063\u3066\u304D\u305F\u306E?\u300D"
  - "\u300C\u3042\u3041\u2026\u3002\u3060\u3044\u3076\u6194\u60B4\u3057\u304D\u3063\u305F\u9854\u3092\u3057\u3066\u3044\u308B\u304C\u4F55\u304B\u3042\u3063\u305F\u306E\u304B?\u3044\u3064\u3082\u5143\u6C17\u306B\u3075\u308B\u307E\u3063\u3066\u3044\u305F\u541B\u3089\u3057\u304F\u306A\u3044\u306D\u3002\u300D"
  - "\u300C\u2026\u2026\u3046\u3093\u3002\u3053\u306E\u6C11\u5BB6\u306B\u602A\u7269\u307F\u305F\u3044\u306A\u72AC\u304C\u3044\u3066\u2026\u2026\u76EE\u306E\u524D\u304C\u898B\u3048\u306A\u304F\u306A\u3063\u3066\u2026\u6C17\u304C\u3064\u3044\u305F\u3089\u3053\u3053\u306B\u7ACB\u3066\u3053\u3082\u3063\u3066\u305F\u3093\u3060\u3002\u300D"
  - "\u300C\u2026\u2026!!\u305D\u3046\u304B\u3001\u541B\u3082\u51FA\u4F1A\u3063\u305F\u306E\u304B\u3002\u300D"
  - "\u300C\u3048\u3001\u304A\u3058\u3055\u3093\u3082\u3042\u306E\u5316\u3051\u7269\u3092\u77E5\u3063\u3066\u3044\u308B\u306E!?\u300D"
  - "\u300C\u3042\u3041\u3001\u8A73\u3057\u3044\u3068\u3044\u3046\u308F\u3051\u3067\u306F\u306A\u3044\u304C\u8DB3\u304C\u304B\u306A\u308A\u7D20\u65E9\u3044\u8089\u98DF\u306E\u5316\u3051\u7269\u3063\u3066\u306E\u306F\u78BA\u5B9A\u3057\u3066\u3044\u308B\u3002\u305D\u3044\u3064\u304B\u3089\u9003\u308C\u308B\u70BA\u306B\u4ED6\u306E\u5834\u6240\u3082\u63A2\u7D22\u3057\u305F\u304C\u7D50\u5C40\u3069\u3053\u3082\u5316\u3051\u7269\u3060\u3089\u3051\u3060\u3063\u305F\u3002\u300D"
  - "\u300C\u305D\u3046\u3060\u3063\u305F\u3093\u3060\u306D\u2026\u2026\u3002\u3082\u3046\u50D5\u305F\u3061\u306B\u9003\u3052\u5834\u306F\u306A\u3044\u306E\u304B\u306A?\u300D"
  - "\u300C\u3044\u3084\u3001\u305D\u3093\u306A\u3053\u3068\u3082\u306A\u3044\u3002\u8AE6\u3081\u308B\u306A\u3063!\u3053\u306E\u6C11\u5BB6\u306E\u4F55\u51E6\u304B\u306B\u3042\u308B\u7206\u5F3E\u3092\u898B\u3064\u3051\u3066\u5751\u9053\u306E\u5927\u5CA9\u3092\u7206\u767A\u3055\u305B\u308C\u3070\u65B0\u3057\u3044\u9053\u304C\u958B\u3051\u308B\u3093\u3060!!\u300D"
  - "\u300C\u65B0\u3057\u3044\u9053\u304C\u2026\u2026\u3002\u3046\u3093\u2026\u2026!\u50D5\u8AE6\u3081\u306A\u3044\u3088\u3063!!\u300D"
  - "\u300C\u3068\u3053\u308D\u3067\u3001\u5411\u304B\u3044\u306E\u90E8\u5C4B\u306E\u9375\u306E\u5834\u6240\u3092\u767A\u898B\u3057\u305F\u3093\u3060\u3051\u3069\u4F55\u304B\u5F79\u306B\u7ACB\u3064\u304B\u306A?\u3053\u306E\u90E8\u5C4B\u306E\u5B9D\u7BB1\u578B\u306E\u53CE\u7D0D\u306B\u5165\u3063\u3066\u308B\u3093\u3060\u3051\u3069\u2026\u2026\u3002\u300D"
  - "\u300C\u672C\u5F53\u304B\u3063!?\u305D\u308C\u306F\u975E\u5E38\u306B\u52A9\u304B\u308B\u306A\u3002\u3042\u308A\u304C\u3068\u3046\u6674\u541B\u3002\u300D"
  - "\u300C\u3044\u3084\u3044\u3084\u2026\u2026\u3042\u3001\u3067\u3082\u305D\u306E\u53CE\u7D0D\u306E\u91D1\u5EAB\u306E\u4E2D\u306B\u5165\u3063\u3066\u308B\u307F\u305F\u3044\u306A\u3093\u3060\u3051\u3069\u91D1\u5EAB\u306E\u6697\u8A3C\u756A\u53F7\u306F\u96A3\u306E\u672C\u68DA\u306B\u30D2\u30F3\u30C8\u304C\u96A0\u3055\u308C\u3066\u3044\u308B\u3093\u3060\u3002\u50D5\u306F\u3055\u3063\u3071\u308A\u308F\u304B\u3089\u306A\u304B\u3063\u305F\u3051\u3069\u306D\u2026\u2026\u3002\u300D"
  - "\u300C\u3044\u3084\u3001\u5341\u5206\u3059\u304E\u308B\u60C5\u5831\u3060\u3002\u7121\u4E8B\u306B\u9375\u3092\u53D6\u308C\u305F\u3089\u307E\u305F\u6559\u3048\u308B\u3088\u3002\u300D"
